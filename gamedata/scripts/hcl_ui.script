    is_shown = false,
    active_state = "HIDDEN",
    active_corpse_id = nil,
    last_inv_hash = nil,
    content_h = 50,
    body_h = 50,
    scroll_pos = 0,
    ui_cell_rows = {},
    has_hidden_ltt = false,
    cur_lerp = {
        initialized = false,
        x = 0,
        y = 0,
        w = 41,
        h = 41,
    },
    last_frame_tg = 0,
}

local ui_runtime = {
    area_hook_installed = false,
    ltt_active_npc_id = nil,
    ltt_xml = nil,
    ltt_xml_checked = false,
    valid_ind_styles = {},
    last_ind_tex = nil,
    ltt_snd_tmr = 0,
    ltt_dots = 0,
    ltt_dots_tmr = 0,
    ltt_cached_text = nil,
    ltt_cached_fac = nil,
}

local CURSOR_COLORS = {
    Amber = { 255, 185, 40 },
    Cyan = { 55, 215, 255 },
    White = { 240, 240, 245 },
    Green = { 75, 240, 100 },
}

