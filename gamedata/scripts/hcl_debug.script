-- [SYSTEM] HclDebug

Z_DEBUG_LEVEL = 0
MODULE_OVERRIDES = {}

-- @z_func: HclDebug.get_level [export:output:debug_hub]
function get_level(mod_name)
    if mod_name and MODULE_OVERRIDES[mod_name] ~= nil then
        return MODULE_OVERRIDES[mod_name]
    end
    return Z_DEBUG_LEVEL
end

-- @z_func: HclDebug.z_probe [export:output:debug_hub]
function z_probe(level, func_name, fmt, ...)
    local fn_str = tostring(func_name or "hcl")
    local mod_prefix = string.match(fn_str, "^([^%.]+)")
    local active_lvl = get_level(mod_prefix)
    if active_lvl <= 0 or (tonumber(level) or 3) > active_lvl then
        return
    end
    local msg
    if select("#", ...) > 0 then
        local ok, formatted = pcall(string.format, tostring(fmt or ""), ...)
        msg = ok and formatted or tostring(fmt or "")
    else
        msg = tostring(fmt or "")
    end
    if printf then
        printf("[Hover Corpse Loot] | %s | %s", fn_str, msg)
    end
end
