-- [SYSTEM] HCL_MCM

local DEFAULTS = {
    hcl_mcm_toggle = true,
    hcl_mcm_cond = true,
    hcl_mcm_parts_cond = true,
    hcl_mcm_parts_repair_type = true,
    hcl_mcm_patches_on_armor = true,
    hcl_mcm_x_offset = 150,
    hcl_mcm_y_offset = 0,
    hcl_mcm_ui_main_x = 300,
    hcl_mcm_ui_opacity = 75,
    hcl_mcm_ui_delay = 200,
    hcl_mcm_max_dist = 2.0,
    hcl_mcm_cursor_color = "Gold",
    hcl_mcm_cursor_color_brightness = 75,
    hcl_mcm_scroll_acceleration = 1.0,
    hcl_mcm_univ_modifier = (DIK_keys and DIK_keys.DIK_LMENU) or 56,
    hcl_mcm_jump_type = "ExactRow",
    hcl_mcm_inv_peek = (DIK_keys and DIK_keys.DIK_LSHIFT) or 42,
    hcl_mcm_peek_scheme = "Hold",
    hcl_mcm_wpn_prt_min_cond = 60,
    hcl_mcm_ial = false,
}

local OPTION_PATHS = {
    hcl_mcm_toggle = "hcl/ui_options/hcl_mcm_toggle",
    hcl_mcm_cond = "hcl/ui_options/hcl_mcm_cond",
    hcl_mcm_parts_cond = "hcl/ui_options/hcl_mcm_parts_cond",
    hcl_mcm_parts_repair_type = "hcl/ui_options/hcl_mcm_parts_repair_type",
    hcl_mcm_patches_on_armor = "hcl/ui_options/hcl_mcm_patches_on_armor",
    hcl_mcm_x_offset = "hcl/ui_options/hcl_mcm_x_offset",
    hcl_mcm_y_offset = "hcl/ui_options/hcl_mcm_y_offset",
    hcl_mcm_ui_main_x = "hcl/ui_options/hcl_mcm_ui_main_x",
    hcl_mcm_ui_opacity = "hcl/ui_options/hcl_mcm_ui_opacity",
    hcl_mcm_ui_delay = "hcl/ui_options/hcl_mcm_ui_delay",
    hcl_mcm_max_dist = "hcl/ui_options/hcl_mcm_max_dist",
    hcl_mcm_cursor_color = "hcl/ui_controls/hcl_mcm_cursor_color",
    hcl_mcm_cursor_color_brightness = "hcl/ui_controls/hcl_mcm_cursor_color_brightness",
    hcl_mcm_scroll_acceleration = "hcl/ui_controls/hcl_mcm_scroll_acceleration",
    hcl_mcm_univ_modifier = "hcl/ui_controls/hcl_mcm_univ_modifier",
    hcl_mcm_jump_type = "hcl/ui_controls/hcl_mcm_jump_type",
    hcl_mcm_inv_peek = "hcl/ui_controls/hcl_mcm_inv_peek",
    hcl_mcm_peek_scheme = "hcl/ui_controls/hcl_mcm_peek_scheme",
    hcl_mcm_wpn_prt_min_cond = "hcl/ui_controls/hcl_mcm_wpn_prt_min_cond",
    hcl_mcm_ial = "hcl/compat/hcl_mcm_ial",
}

local mcm_cache = {}
for k, v in pairs(DEFAULTS) do
    mcm_cache[k] = v
end
local mcm_initialized = false

-- @z_func: HCL_MCM.z_probe [internal:shared]
local function z_probe(level, func_name, fmt, ...)
    if hcl_debug and hcl_debug.z_probe then
        hcl_debug.z_probe(level, func_name, fmt, ...)
    end
end

-- @z_func: HCL_MCM.is_wpo_present [internal:HCL_MCM.output] | bind:hcl_mcm_schema_and_list_keys
local function is_wpo_present()
    return _G.arti_jamming ~= nil
end

-- @z_func: HCL_MCM.is_wpo_absent [internal:HCL_MCM.output] | bind:hcl_mcm_schema_and_list_keys
local function is_wpo_absent()
    return _G.arti_jamming == nil
end

-- @z_func: HCL_MCM.is_ial_present [internal:HCL_MCM.output] | bind:hcl_mcm_schema_and_list_keys
local function is_ial_present()
    return _G.z_auto_looter ~= nil
end

-- @z_func: HCL_MCM.is_ial_absent [internal:HCL_MCM.output] | bind:hcl_mcm_schema_and_list_keys
local function is_ial_absent()
    return _G.z_auto_looter == nil
end

-- @z_func: HCL_MCM.refresh_mcm_cache [internal:HCL_MCM.output] | bind:hcl_mcm_schema_and_list_keys
local function refresh_mcm_cache()
    if not ui_mcm then
        return
    end
    for key, path in pairs(OPTION_PATHS) do
        local val = ui_mcm.get(path)
        if val ~= nil then
            mcm_cache[key] = val
        else
            mcm_cache[key] = DEFAULTS[key]
        end
    end
    mcm_initialized = true
    z_probe(2, "hcl_mcm.refresh_mcm_cache", "Refreshed MCM cache (toggle=%s, delay=%s, max_dist=%s)", tostring(mcm_cache.hcl_mcm_toggle), tostring(mcm_cache.hcl_mcm_ui_delay), tostring(mcm_cache.hcl_mcm_max_dist))
end

-- @z_func: HCL_MCM.get_config [export:output:HCL_MCM.output] | bind:hcl_mcm_schema_and_list_keys
function get_config(key)
    if not mcm_initialized then
        refresh_mcm_cache()
    end
    if key == "hcl_mcm_ial" and _G.z_auto_looter == nil then
        return false
    end
    local val = mcm_cache[key]
    if val ~= nil then
        return val
    end
    return DEFAULTS[key]
end

-- @z_func: HCL_MCM.get_inv_peek_dik [export:output:HCL_MCM.output] | bind:hcl_loot_quick_peek_keybind
function get_inv_peek_dik()
    if not mcm_initialized then
        refresh_mcm_cache()
    end
    return tonumber(mcm_cache.hcl_mcm_inv_peek) or DEFAULTS.hcl_mcm_inv_peek
end

-- @z_func: HCL_MCM.get_peek_scheme [export:output:HCL_MCM.output] | bind:hcl_loot_quick_peek_keybind
function get_peek_scheme()
    if not mcm_initialized then
        refresh_mcm_cache()
    end
    local val = mcm_cache.hcl_mcm_peek_scheme
    if val == "Toggle" then
        return "Toggle"
    end
    return "Hold"
end

-- @z_func: HCL_MCM.on_mcm_load [export:callback:HCL_MCM.output] | bind:hcl_mcm_schema_and_list_keys
function on_mcm_load()
    local op = {
        id = "hcl",
        gr = {
            {
                id = "ui_options",
                sh = true,
                text = "ui_mcm_hcl_ui_options",
                gr = {
                    { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_hcl_title", size = { 512, 50 }, spacing = 20 },
                    { id = "hcl_mcm_toggle", type = "check", val = 1, def = true },
                    { id = "divider_top", type = "line" },
                    { id = "hcl_mcm_cond", type = "check", val = 1, def = true },
                    { id = "hcl_mcm_parts_cond", type = "check", val = 1, def = true },
                    { id = "hcl_mcm_parts_repair_type", type = "check", val = 1, def = true },
                    { id = "hcl_mcm_patches_on_armor", type = "check", val = 1, def = true },
                    { id = "divider_mid", type = "line" },
                    { id = "hcl_mcm_x_offset", type = "track", val = 2, min = -500, max = 500, step = 10, def = 150 },
                    { id = "hcl_mcm_y_offset", type = "track", val = 2, min = -250, max = 250, step = 10, def = 0 },
                    { id = "hcl_mcm_ui_main_x", type = "track", val = 2, min = 200, max = 500, step = 10, def = 300 },
                    { id = "hcl_mcm_ui_opacity", type = "track", val = 2, min = 10, max = 100, step = 1, def = 75 },
                    { id = "hcl_mcm_ui_delay", type = "track", val = 2, min = 100, max = 500, step = 10, def = 200 },
                    { id = "hcl_mcm_max_dist", type = "track", val = 2, min = 2.0, max = 5.0, step = 0.5, prec = 1, def = 2.0 },
                },
            },
            {
                id = "ui_controls",
                sh = true,
                text = "ui_mcm_hcl_ui_controls",
                gr = {
                    { id = "controls_title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_hcl_controls_title", size = { 512, 50 }, spacing = 20 },
                    {
                        id = "hcl_mcm_cursor_color",
                        type = "list",
                        val = 0,
                        def = "Gold",
                        no_str = true,
                        content = {
                            { "Gold", "ui_mcm_lst_hcl_color_gold" },
                            { "Cyan", "ui_mcm_lst_hcl_color_cyan" },
                            { "White", "ui_mcm_lst_hcl_color_white" },
                            { "Green", "ui_mcm_lst_hcl_color_green" },
                            { "Blue", "ui_mcm_lst_hcl_color_blue" },
                        },
                    },
                    { id = "hcl_mcm_cursor_color_brightness", type = "track", val = 2, min = 1, max = 100, step = 1, def = 75 },
                    { id = "hcl_mcm_scroll_acceleration", type = "track", val = 2, min = 1.0, max = 5.0, step = 0.1, prec = 1, def = 1.0 },
                    { id = "hcl_mcm_univ_modifier", type = "key_bind", val = 2, def = (DIK_keys and DIK_keys.DIK_LMENU) or 56 },
                    {
                        id = "hcl_mcm_jump_type",
                        type = "list",
                        val = 0,
                        def = "ExactRow",
                        no_str = true,
                        content = {
                            { "ExactRow", "ui_mcm_lst_hcl_jump_exact_row" },
                            { "ItemKind", "ui_mcm_lst_hcl_jump_item_kind" },
                        },
                    },
                    { id = "hcl_mcm_inv_peek", type = "key_bind", val = 2, def = (DIK_keys and DIK_keys.DIK_LSHIFT) or 42 },
                    {
                        id = "hcl_mcm_peek_scheme",
                        type = "list",
                        val = 0,
                        def = "Hold",
                        no_str = true,
                        content = {
                            { "Hold", "ui_mcm_lst_hcl_peek_hold" },
                            { "Toggle", "ui_mcm_lst_hcl_peek_toggle" },
                        },
                    },
                    { id = "hcl_mcm_wpn_prt_min_cond", type = "track", val = 2, min = 1, max = 100, step = 1, def = 60, precondition = { is_wpo_present } },
                    { id = "hcl_mcm_wpn_prt_min_cond_disabled", type = "desc", text = "ui_mcm_hcl_ui_controls_hcl_mcm_wpn_prt_min_cond_disabled", clr = { 130, 140, 140, 140 }, precondition = { is_wpo_absent } },
                },
            },
            {
                id = "compat",
                sh = true,
                text = "ui_mcm_hcl_compat",
                gr = {
                    { id = "compat_title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_hcl_compat_title", size = { 512, 50 }, spacing = 20 },
                    { id = "hcl_mcm_ial", type = "check", val = 1, def = false, precondition = { is_ial_present } },
                    { id = "hcl_mcm_ial_disabled", type = "desc", text = "ui_mcm_hcl_compat_hcl_mcm_ial_disabled", clr = { 130, 140, 140, 140 }, precondition = { is_ial_absent } },
                },
            },
        },
    }
    return op
end

-- @z_func: HCL_MCM.on_option_change [export:callback:HCL_MCM.output] | bind:hcl_mcm_schema_and_list_keys
function on_option_change()
    refresh_mcm_cache()
end

-- @z_func: HCL_MCM.actor_on_first_update [export:callback:HCL_MCM.output] | bind:hcl_mcm_schema_and_list_keys
function actor_on_first_update()
    if not mcm_initialized then
        refresh_mcm_cache()
    end
end

-- @z_func: HCL_MCM.on_game_start [export:callback:HCL_MCM.output] | bind:hcl_mcm_schema_and_list_keys
function on_game_start()
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("on_option_change", on_option_change)
end
