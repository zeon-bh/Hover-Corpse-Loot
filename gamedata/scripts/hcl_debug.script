-- [SYSTEM] HCL_Debug

Z_DEBUG_LEVEL = 0

module_overrides = {
    HCL_MCM = nil,
    HCL_Main = nil,
    HCL_Loot = nil,
    HCL_UI = nil,
}

-- @z [HCL_Debug] helper:get_effective_level
-- @z_func: HCL_Debug.get_effective_level [export:output]
function get_effective_level(module_name)
    if module_name and module_overrides[module_name] ~= nil then
        return module_overrides[module_name]
    end
    return Z_DEBUG_LEVEL
end

-- @z [HCL_Debug] helper:z_probe
-- @z_func: HCL_Debug.z_probe [export:output]
function z_probe(func_name, fmt, ...)
    local mod_prefix = func_name and string.match(tostring(func_name), "^([A-Za-z0-9_]+)%.") or nil
    local eff_lvl = get_effective_level(mod_prefix)
    if eff_lvl <= 0 then
        return
    end
    local ok, msg = pcall(string.format, fmt, ...)
    printf("[Hover Corpse Loot] | %s | %s", tostring(func_name), ok and msg or tostring(fmt))
end
