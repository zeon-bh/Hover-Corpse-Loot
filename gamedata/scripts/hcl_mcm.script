-- [SYSTEM] HCL_MCM

-- @z [HCL_MCM] helper:z_probe
-- @z_func: HCL_MCM.z_probe [internal]
local function z_probe(func_name, fmt, ...)
    if hcl_debug and hcl_debug.z_probe then
        hcl_debug.z_probe(func_name, fmt, ...)
    end
end

-- @z [HCL_MCM] data:UI Options
local defaults = {
    hcl_toggle = true,
    hcl_cond = true,
    hcl_parts_cond = true,
    hcl_parts_repair_type = true,
    hcl_patches_on_armor = true,
    hcl_x_offset = 150,
    hcl_y_offset = 0,
    hcl_ui_main_x = 300,
    hcl_ui_opacity = 75,
    hcl_ui_delay = 200,
    hcl_max_dist = 2.0,
    hcl_bg_scolor = "Amber",
    hcl_bg_scolor_brightness = 75,
    hcl_s_acceleration = 1.0,
    hcl_univ_modifier = DIK_keys and DIK_keys.DIK_LMENU or 56,
    hcl_jump_type = "Exact Row",
    hcl_wpn_prt_min_cond = 60,
}

-- @z [HCL_MCM] data:UI Controls
local config = {}
for k, v in pairs(defaults) do
    config[k] = v
end

local mcm_key_paths = {
    hcl_toggle = "hcl/ui_options/hcl_toggle",
    hcl_cond = "hcl/ui_options/hcl_cond",
    hcl_parts_cond = "hcl/ui_options/hcl_parts_cond",
    hcl_parts_repair_type = "hcl/ui_options/hcl_parts_repair_type",
    hcl_patches_on_armor = "hcl/ui_options/hcl_patches_on_armor",
    hcl_x_offset = "hcl/ui_options/hcl_x_offset",
    hcl_y_offset = "hcl/ui_options/hcl_y_offset",
    hcl_ui_main_x = "hcl/ui_options/hcl_ui_main_x",
    hcl_ui_opacity = "hcl/ui_options/hcl_ui_opacity",
    hcl_ui_delay = "hcl/ui_options/hcl_ui_delay",
    hcl_max_dist = "hcl/ui_options/hcl_max_dist",
    hcl_bg_scolor = "hcl/ui_controls/hcl_bg_scolor",
    hcl_bg_scolor_brightness = "hcl/ui_controls/hcl_bg_scolor_brightness",
    hcl_s_acceleration = "hcl/ui_controls/hcl_s_acceleration",
    hcl_univ_modifier = "hcl/ui_controls/hcl_univ_modifier",
    hcl_jump_type = "hcl/ui_controls/hcl_jump_type",
    hcl_wpn_prt_min_cond = "hcl/ui_controls/hcl_wpn_prt_min_cond",
}

-- Pure literal initialization at top-level module scope; never index grok_gun_no_condition_text
-- or z_item_icon_info at top-level while ui_mcm.gather_options() runs in the Main Menu.
local gamma_hides_gun_cond = false

-- @z [HCL_MCM] rule:UI Options | bind:hcl_cond_gamma_gun_hide
-- @z_func: HCL_MCM.get_config [export:output]
function get_config(key)
    if key == nil then
        return config
    end
    local val = config[key]
    if val ~= nil then
        return val
    end
    return defaults[key]
end

-- @z [HCL_MCM] helper:get | bind:hcl_cond_gamma_gun_hide
-- @z_func: HCL_MCM.get [export:output]
function get(key)
    return get_config(key)
end

-- @z [HCL_MCM] rule:is_gamma_gun_cond_hidden | bind:hcl_cond_gamma_gun_hide
-- @z_func: HCL_MCM.is_gamma_gun_cond_hidden [export:output]
function is_gamma_gun_cond_hidden()
    return gamma_hides_gun_cond == true
end

-- @z [HCL_MCM] rule:should_show_cond | bind:hcl_cond_gamma_gun_hide
-- @z_func: HCL_MCM.should_show_cond [export:output]
function should_show_cond(obj, clsid)
    if not get_config("hcl_cond") then
        return false
    end
    local has_valid_obj = (obj ~= nil and type(obj) == "userdata" and type(obj.clsid) == "function")
    if gamma_hides_gun_cond and (has_valid_obj or clsid ~= nil) then
        -- Suppress overall condition percentage text on non-melee firearms when
        -- grok_gun_no_condition_text (z_item_icon_info.Add_Condition_Text / Add_Weapon_Name) is active.
        if IsWeapon(obj, clsid) and not IsMelee(obj, clsid) then
            return false
        end
    end
    return true
end

-- @z [HCL_MCM] helper:refresh_mcm_values
-- @z_func: HCL_MCM.refresh_mcm_values [export:callback]
function refresh_mcm_values()
    if not ui_mcm then
        return
    end
    for key, path in pairs(mcm_key_paths) do
        local v = ui_mcm.get(path)
        if v ~= nil then
            if key == "hcl_jump_type" then
                if v == "ExactRow" then
                    v = "Exact Row"
                elseif v == "ItemKind" then
                    v = "Item Kind"
                end
            end
            config[key] = v
        end
    end
    z_probe("refresh_mcm_values", "toggle=%s delay=%s max_dist=%s", tostring(config.hcl_toggle), tostring(config.hcl_ui_delay), tostring(config.hcl_max_dist))
end

-- @z [HCL_MCM] dispatcher:on_option_change
-- @z_func: HCL_MCM.on_option_change [export:callback]
function on_option_change(mcm)
    if mcm then
        refresh_mcm_values()
    end
end

-- @z [HCL_MCM] dispatcher:on_mcm_load | bind:hcl_cond_gamma_gun_hide
-- @z_func: HCL_MCM.on_mcm_load [export:output]
function on_mcm_load()
    local op = {
        id = "hcl",
        gr = {
            {
                id = "ui_options",
                sh = true,
                gr = {
                    { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_hcl_title", size = { 512, 50 }, spacing = 20 },
                    { id = "hcl_toggle", type = "check", val = 1, def = defaults.hcl_toggle },
                    { id = "divider_1", type = "line" },
                    { id = "hcl_cond", type = "check", val = 1, def = defaults.hcl_cond },
                    { id = "hcl_parts_cond", type = "check", val = 1, def = defaults.hcl_parts_cond },
                    { id = "hcl_parts_repair_type", type = "check", val = 1, def = defaults.hcl_parts_repair_type },
                    { id = "hcl_patches_on_armor", type = "check", val = 1, def = defaults.hcl_patches_on_armor },
                    { id = "divider_2", type = "line" },
                    { id = "hcl_x_offset", type = "track", val = 2, min = 0, max = 500, step = 5, def = defaults.hcl_x_offset },
                    { id = "hcl_y_offset", type = "track", val = 2, min = 0, max = 250, step = 5, def = defaults.hcl_y_offset },
                    { id = "hcl_ui_main_x", type = "track", val = 2, min = 200, max = 500, step = 10, def = defaults.hcl_ui_main_x },
                    { id = "hcl_ui_opacity", type = "track", val = 2, min = 10, max = 100, step = 1, def = defaults.hcl_ui_opacity },
                    { id = "hcl_ui_delay", type = "track", val = 2, min = 100, max = 500, step = 10, def = defaults.hcl_ui_delay },
                    { id = "hcl_max_dist", type = "track", val = 2, min = 2, max = 5, step = 0.5, def = defaults.hcl_max_dist },
                },
            },
            {
                id = "ui_controls",
                sh = true,
                gr = {
                    { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_hcl_title", size = { 512, 50 }, spacing = 20 },
                    {
                        id = "hcl_bg_scolor",
                        type = "list",
                        val = 0,
                        def = defaults.hcl_bg_scolor,
                        content = {
                            { "Amber", "hcl_amber" },
                            { "Cyan", "hcl_cyan" },
                            { "White", "hcl_white" },
                            { "Green", "hcl_green" },
                        },
                    },
                    { id = "hcl_bg_scolor_brightness", type = "track", val = 2, min = 1, max = 100, step = 1, def = defaults.hcl_bg_scolor_brightness },
                    { id = "hcl_s_acceleration", type = "track", val = 2, min = 1.0, max = 5.0, step = 0.1, def = defaults.hcl_s_acceleration },
                    { id = "hcl_univ_modifier", type = "key_bind", val = 2, def = defaults.hcl_univ_modifier },
                    {
                        id = "hcl_jump_type",
                        type = "list",
                        val = 0,
                        def = "ExactRow",
                        content = {
                            { "ExactRow", "hcl_exact_row" },
                            { "ItemKind", "hcl_item_kind" },
                        },
                    },
                    { id = "hcl_wpn_prt_min_cond", type = "track", val = 2, min = 1, max = 100, step = 1, def = defaults.hcl_wpn_prt_min_cond },
                },
            },
        },
    }
    return op
end

-- @z [HCL_MCM] dispatcher:on_game_start | bind:hcl_cond_gamma_gun_hide
-- @z_func: HCL_MCM.on_game_start [export:callback]
function on_game_start()
    gamma_hides_gun_cond = (_G.grok_gun_no_condition_text ~= nil)
    if _G.z_item_icon_info and _G.z_item_icon_info.Add_Condition_Text and _G.z_item_icon_info.Add_Weapon_Name then
        z_probe("on_game_start", "z_item_icon_info detected (gamma_hides_gun_cond=%s)", tostring(gamma_hides_gun_cond))
    end
    refresh_mcm_values()
    RegisterScriptCallback("on_option_change", on_option_change)
end
