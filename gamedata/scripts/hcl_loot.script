-- [SYSTEM] HCL_Loot

-- @z [HCL_Loot] data:Hover UI parameters | bind:hcl_loot_looted_items_lifecycle
local loot_params = {
    item_grid = {},
    cursor_idx = nil,
    cursor_object = nil,
    alt_modifier = false,
    corpse_looted = false,
    looted_items = nil,
}

local loot_state = "IDLE"
local grid_version = 0
local active_corpse_id = nil
local last_grid_checksum = nil
local next_checksum_tg = 0
local force_grid_rebuild = false
local blacklisted_ids = {}
local iter_items_scratch = {}
local mod_key_fallback_held = false
local lmb_held = false
local lmb_pressed_in_loot = false
local rmb_pressed_in_loot = false
local sweep_triggered_this_hold = false
local sweep_brake_until_tg = 0
local last_wheel_tg = 0
local wheel_burst_vel = 0
local mbc_state = "MBC"
local mbc_debounce_until_tg = 0
local loot_hooks_installed = false
local orig_loot_create_time_event = nil
local disasm_redirect_npc_id = nil
local disasm_redirect_until_tg = 0
local disasm_intercepted = false
local looted_ledger = { corpse_id = nil, stack = {}, ids = {} }
local corpse_snapshot_ids = {}
local corpse_snapshot_npc_id = nil
local manual_loot_transfer_active = false
local loot_ledger_seq = 0
local last_inv_grid_key = nil
local next_inv_prune_tg = 0
local mcm_loot_ready = false
local cached_mod_dik = (DIK_keys and DIK_keys.DIK_LMENU) or 56
local cached_peek_dik = (DIK_keys and DIK_keys.DIK_LSHIFT) or 42
local cached_peek_scheme = "Hold"
local peek_hold_fallback = false
local peek_edge_held = false
local peek_toggle_active = false

-- @z_func: HCL_Loot.z_probe [internal:shared]
local function z_probe(level, func_name, fmt, ...)
    if hcl_debug and hcl_debug.z_probe then
        hcl_debug.z_probe(level, func_name, fmt, ...)
    end
end

-- @z_func: HCL_Loot.noop_ui_npc_on_use [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT
local function noop_ui_npc_on_use()
end

-- @z_func: HCL_Loot.delayed_grid_refresh_cb [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT,PREVIEW
local function delayed_grid_refresh_cb()
    force_grid_rebuild = true
    return true
end

-- @z_func: HCL_Loot.blacklist_item_id [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT
local function blacklist_item_id(item_id, duration_ms)
    if not item_id then
        return
    end
    blacklisted_ids[item_id] = time_global() + (duration_ms or 850)
end

-- @z_func: HCL_Loot.is_id_blacklisted [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT,PREVIEW
local function is_id_blacklisted(item_id, tg)
    local exp = blacklisted_ids[item_id]
    if not exp then
        return false
    end
    if tg >= exp then
        blacklisted_ids[item_id] = nil
        return false
    end
    return true
end

-- @z_func: HCL_Loot.refresh_loot_mcm_cache [internal:Hover Loot Global Rules] | bind:hcl_loot_quick_peek_keybind
local function refresh_loot_mcm_cache()
    local prev_scheme = cached_peek_scheme
    local prev_peek_dik = cached_peek_dik
    if hcl_mcm and hcl_mcm.get_config then
        cached_mod_dik = tonumber(hcl_mcm.get_config("hcl_mcm_univ_modifier")) or ((DIK_keys and DIK_keys.DIK_LMENU) or 56)
        cached_peek_dik = tonumber(hcl_mcm.get_config("hcl_mcm_inv_peek")) or ((DIK_keys and DIK_keys.DIK_LSHIFT) or 42)
        local scheme = hcl_mcm.get_config("hcl_mcm_peek_scheme")
        cached_peek_scheme = (scheme == "Toggle") and "Toggle" or "Hold"
        mcm_loot_ready = true
    end
    if cached_peek_scheme ~= prev_scheme or cached_peek_dik ~= prev_peek_dik or cached_peek_dik <= 0 then
        peek_toggle_active = false
        peek_hold_fallback = false
        peek_edge_held = false
    end
end

-- @z_func: HCL_Loot.sync_looted_items_view [internal:Hover Loot Global Rules] | bind:hcl_loot_looted_items_lifecycle
local function sync_looted_items_view()
    if looted_ledger.corpse_id == nil or #looted_ledger.stack == 0 then
        loot_params.looted_items = nil
        return
    end
    loot_params.looted_items = {
        corpse_id = looted_ledger.corpse_id,
        stack = looted_ledger.stack,
        ids = looted_ledger.ids,
    }
end

-- @z_func: HCL_Loot.clear_looted_ledger [internal:Hover Loot Global Rules] | bind:hcl_loot_looted_items_lifecycle
local function clear_looted_ledger(reason)
    local had_any = (looted_ledger.corpse_id ~= nil) or (#looted_ledger.stack > 0)
    looted_ledger.corpse_id = nil
    looted_ledger.stack = {}
    looted_ledger.ids = {}
    loot_params.looted_items = nil
    last_inv_grid_key = nil
    if had_any then
        loot_ledger_seq = loot_ledger_seq + 1
        z_probe(2, "hcl_loot.clear_looted_ledger", "Cleared looted_items ledger (%s)", tostring(reason or "reset"))
    end
end

-- @z_func: HCL_Loot.remove_ledger_item_id [internal:Hover Loot Global Rules] | bind:hcl_loot_looted_items_lifecycle
local function remove_ledger_item_id(item_id)
    if not item_id or not looted_ledger.ids[item_id] then
        return false
    end
    looted_ledger.ids[item_id] = nil
    local new_stack = {}
    for i = 1, #looted_ledger.stack do
        local grp = looted_ledger.stack[i]
        local kept = {}
        for j = 1, #grp do
            local gid = grp[j]
            if gid ~= item_id and looted_ledger.ids[gid] then
                kept[#kept + 1] = gid
            end
        end
        if #kept > 0 then
            new_stack[#new_stack + 1] = kept
        end
    end
    looted_ledger.stack = new_stack
    if #new_stack == 0 then
        looted_ledger.ids = {}
        looted_ledger.corpse_id = nil
    end
    loot_ledger_seq = loot_ledger_seq + 1
    sync_looted_items_view()
    return true
end

-- @z_func: HCL_Loot.push_ledger_entry [internal:Hover Loot Global Rules] | bind:hcl_loot_looted_items_lifecycle
local function push_ledger_entry(corpse_id, moved_ids)
    if not corpse_id or not moved_ids or #moved_ids == 0 then
        return
    end
    if looted_ledger.corpse_id ~= nil and looted_ledger.corpse_id ~= corpse_id then
        clear_looted_ledger("corpse_swap_on_push")
    end
    looted_ledger.corpse_id = corpse_id
    local entry = {}
    for i = 1, #moved_ids do
        local iid = moved_ids[i]
        if iid and not looted_ledger.ids[iid] then
            looted_ledger.ids[iid] = true
            entry[#entry + 1] = iid
        end
    end
    if #entry > 0 then
        looted_ledger.stack[#looted_ledger.stack + 1] = entry
        loot_ledger_seq = loot_ledger_seq + 1
        sync_looted_items_view()
    end
end

-- @z_func: HCL_Loot.prune_live_ledger [internal:Hover Loot Global Rules] | bind:hcl_loot_looted_items_lifecycle
local function prune_live_ledger(tg)
    if looted_ledger.corpse_id == nil or #looted_ledger.stack == 0 then
        return 0
    end
    local actor_id = db.actor and db.actor:id() or 0
    local npc_id = looted_ledger.corpse_id
    local changed = false
    local new_stack = {}
    local valid_count = 0
    for i = 1, #looted_ledger.stack do
        local grp = looted_ledger.stack[i]
        local kept = {}
        for j = 1, #grp do
            local iid = grp[j]
            local obj = iid and level.object_by_id(iid) or nil
            local parent = obj and obj:parent() or nil
            local pid = parent and parent:id() or nil
            -- Allow items still completing async corpse->actor GE_TRANSFER_TAKE within the 850ms blacklist window.
            local valid = (obj ~= nil) and (pid == actor_id or (pid == npc_id and is_id_blacklisted(iid, tg)))
            if valid then
                kept[#kept + 1] = iid
                valid_count = valid_count + 1
            else
                if iid and looted_ledger.ids[iid] then
                    looted_ledger.ids[iid] = nil
                end
                changed = true
            end
        end
        if #kept > 0 then
            new_stack[#new_stack + 1] = kept
        else
            changed = true
        end
    end
    if changed then
        looted_ledger.stack = new_stack
        if #new_stack == 0 then
            looted_ledger.ids = {}
            looted_ledger.corpse_id = nil
        end
        loot_ledger_seq = loot_ledger_seq + 1
        sync_looted_items_view()
    end
    return valid_count
end

local sec_vis_cache = {}

-- @z_func: HCL_Loot.is_corpse_item_visible [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT,PREVIEW
local function is_corpse_item_visible(item, npc_id, tg)
    if not item then
        return false
    end
    local iid = item:id()
    if is_id_blacklisted(iid, tg) then
        return false
    end
    local sec = item:section()
    local cached = sec_vis_cache[sec]
    if cached == nil then
        if sec == "device_pda" or sec == "device_torch_dummy" or sec == "items_anm_dummy" then
            cached = false
        else
            local is_bolt_item = (sec == "bolt" or sec == "bolt_bullet" or (IsBolt and IsBolt(item)))
            if (not is_bolt_item) and IsItem("anim", sec) then
                cached = false
            else
                local gw = ini_sys:r_float_ex(sec, "inv_grid_width", 0) or 0
                cached = (gw > 0)
            end
        end
        sec_vis_cache[sec] = cached
    end
    if not cached then
        return false
    end
    if hcl_patch and hcl_patch.get_item_reveal_state(npc_id, iid) == "hidden" then
        return false
    end
    return true
end

-- @z_func: HCL_Loot.collect_corpse_item_cb [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT,PREVIEW
local function collect_corpse_item_cb(npc, item)
    if is_corpse_item_visible(item, active_corpse_id, next_checksum_tg) then
        iter_items_scratch[#iter_items_scratch + 1] = item
    end
end

-- @z_func: HCL_Loot.read_native_corpse_looted [internal:PREVIEW] | bind:hcl_loot_phase2_rewards_and_se_storage | states:PREVIEW,LOOT
local function read_native_corpse_looted(npc)
    if not npc or not se_load_var then
        return false
    end
    local id = npc:id()
    local name = npc:name()
    if se_load_var(id, name, "hcl_looted") == true then
        return true
    end
    if se_load_var(id, name, "death_dropped") == true and not se_load_var(id, name, "hcl_phase1_only") then
        return true
    end
    return false
end

-- @z_func: HCL_Loot.flush_scavenger_for_corpse [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT
local function flush_scavenger_for_corpse(npc, id, name)
    if not (se_load_var and se_load_var(id, name, "hcl_scav_deferred") == true) then
        return
    end
    if se_save_var then
        se_save_var(id, name, "hcl_scav_deferred", false)
    end
    if _G.liz_fdda_redone_body_search and type(_G.liz_fdda_redone_body_search.haruka_scavanger_effect) == "function" then
        _G.liz_fdda_redone_body_search.haruka_scavanger_effect()
    elseif _G.haru_skills and type(_G.haru_skills.scavanger_effect) == "function" then
        _G.haru_skills.scavanger_effect(npc)
    end
end

-- @z_func: HCL_Loot.transfer_corpse_quest_info [internal:LOOT] | bind:hcl_loot_vanilla_transfer_signals | states:LOOT
local function transfer_corpse_quest_info(npc)
    if not (npc and IsStalker(npc) and not npc:alive()) then
        return
    end
    local ui_cls = _G.ui_inventory and _G.ui_inventory.UIInventory or nil
    if ui_cls and type(ui_cls.LMode_TransferInfo) == "function" then
        ui_cls.LMode_TransferInfo(nil, npc)
        return
    end
    local custom_data = ini_sys:r_string_ex(npc:section(), "custom_data")
    local char_ini = custom_data and ini_file(custom_data) or nil
    local known_info = char_ini and char_ini:r_string_ex("logic", "known_info") or nil
    if known_info and char_ini:section_exist(known_info) then
        local n = char_ini:line_count(known_info)
        for i = 0, n - 1 do
            local _, id = char_ini:r_line(known_info, i, "", "")
            if id and id ~= "" and npc:has_info(id) then
                npc:disable_info_portion(id)
                give_info(id)
            end
        end
    end
end

-- @z_func: HCL_Loot.execute_phase2_corpse_rewards [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT
local function execute_phase2_corpse_rewards(npc)
    if not npc or not db.actor then
        return
    end
    local id = npc:id()
    local name = npc:name()
    local already_looted = read_native_corpse_looted(npc)
    if already_looted then
        loot_params.corpse_looted = true
        return
    end
    -- Persist native looted flags before invoking callbacks to prevent re-entrant money/stash duplication.
    if se_save_var then
        se_save_var(id, name, "hcl_looted", true)
        se_save_var(id, name, "hcl_phase1_only", false)
    end
    loot_params.corpse_looted = true
    if _G.item_money and type(_G.item_money.actor_on_loot_money) == "function" then
        _G.item_money.actor_on_loot_money(npc)
    end
    if character_community then
        SendScriptCallback("actor_on_interaction", "factions", nil, character_community(npc))
    end
    flush_scavenger_for_corpse(npc, id, name)
    local ui_cls = _G.ui_inventory and _G.ui_inventory.UIInventory or nil
    local orig_npc_use = ui_cls and ui_cls.npc_on_use or nil
    if ui_cls then
        ui_cls.npc_on_use = noop_ui_npc_on_use
    end
    local ok, err = pcall(SendScriptCallback, "npc_on_use", npc, db.actor)
    if ui_cls then
        ui_cls.npc_on_use = orig_npc_use
    end
    if not ok then
        z_probe(1, "hcl_loot.execute_phase2_corpse_rewards", "Phase-2 npc_on_use subscriber error: %s", tostring(err))
    end
    force_grid_rebuild = true
    if CreateTimeEvent then
        CreateTimeEvent("hcl_loot_p2", "p2_" .. tostring(id), 0.15, delayed_grid_refresh_cb)
    end
    z_probe(2, "hcl_loot.execute_phase2_corpse_rewards", "Executed Phase-2 corpse rewards for id=%s", tostring(id))
end

-- @z_func: HCL_Loot.build_corpse_checksum [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT,PREVIEW
local function build_corpse_checksum(npc, tg)
    local npc_id = npc:id()
    active_corpse_id = npc_id
    next_checksum_tg = tg
    iter_items_scratch = {}
    npc:iterate_inventory(collect_corpse_item_cb, npc)
    local patch_seq = (hcl_patch and hcl_patch.get_patch_dirty_seq()) or 0
    local main_x = (hcl_mcm and tonumber(hcl_mcm.get_config("hcl_mcm_ui_main_x"))) or 300
    local n_items = #iter_items_scratch
    local snap = {}
    corpse_snapshot_npc_id = npc_id
    -- Zero-allocation 53-bit integer rolling hash avoids per-item string.format + table.concat GC churn every 100ms.
    local MOD = 2147483629
    local h = (((npc_id * 131 + patch_seq) % MOD) * 131 + main_x * 31 + n_items) % MOD
    for i = 1, n_items do
        local it = iter_items_scratch[i]
        local iid = it:id()
        snap[iid] = true
        local rev = (hcl_patch and hcl_patch.get_item_reveal_state(npc_id, iid)) or "revealed"
        local rev_code = (rev == "revealed" and 2) or (rev == "silhouette" and 1) or 0
        local mag_cnt = ((hcl_patch and hcl_patch.get_magazine_ammo_count(it)) or -1) + 2
        local ammo_cnt = ((it.ammo_get_count and it:ammo_get_count()) or -1) + 2
        local uses_cnt = ((it.get_remaining_uses and it:get_remaining_uses()) or -1) + 2
        local cond_int = math.floor((it:condition() or 1) * 100 + 0.5)
        h = (h * 1009 + iid * 37 + rev_code * 17 + mag_cnt * 13 + ammo_cnt * 7 + uses_cnt * 3 + cond_int) % MOD
    end
    corpse_snapshot_ids = snap
    return h, iter_items_scratch
end

-- @z_func: HCL_Loot.rebuild_corpse_item_grid [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT,PREVIEW
local function rebuild_corpse_item_grid(npc, raw_items)
    local npc_id = npc:id()
    local items_copy = {}
    for i = 1, #raw_items do
        items_copy[i] = raw_items[i]
    end
    if hcl_patch and hcl_patch.compare_items then
        table.sort(items_copy, hcl_patch.compare_items)
    end
    -- Bucket candidate stacks by section so stack merging stays O(N) instead of scanning all distinct stacks O(N^2).
    local stacks = {}
    local stacks_by_sec = {}
    for i = 1, #items_copy do
        local obj = items_copy[i]
        local sec = obj:section()
        local merged = false
        local sec_bucket = stacks_by_sec[sec]
        if sec_bucket and hcl_patch then
            for j = 1, #sec_bucket do
                local grp = sec_bucket[j]
                if hcl_patch.can_stack_items(grp.obj, obj, npc_id) then
                    grp.items[#grp.items + 1] = obj
                    grp.ids[#grp.ids + 1] = obj:id()
                    merged = true
                    break
                end
            end
        end
        if not merged then
            local gw, gh
            if hcl_patch and hcl_patch.get_effective_grid_wh then
                gw, gh = hcl_patch.get_effective_grid_wh(sec)
            else
                gw = math.max(1, math.floor((ini_sys:r_float_ex(sec, "inv_grid_width", 1) or 1) + 0.5))
                gh = math.max(1, math.floor((ini_sys:r_float_ex(sec, "inv_grid_height", 1) or 1) + 0.5))
            end
            local cat_rank = (hcl_patch and hcl_patch.get_item_category_rank(obj, sec)) or 999
            local new_grp = {
                obj = obj,
                id = obj:id(),
                sec = sec,
                items = { obj },
                ids = { obj:id() },
                grid_w = gw,
                grid_h = gh,
                cat_rank = cat_rank,
            }
            stacks[#stacks + 1] = new_grp
            if not sec_bucket then
                sec_bucket = {}
                stacks_by_sec[sec] = sec_bucket
            end
            sec_bucket[#sec_bucket + 1] = new_grp
        end
    end

    local main_x = (hcl_mcm and tonumber(hcl_mcm.get_config("hcl_mcm_ui_main_x"))) or 300
    local ratio = (_G.utils_xml and _G.utils_xml.screen_ratio and _G.utils_xml.screen_ratio()) or 0.75
    local max_cols = (hcl_patch and hcl_patch.compute_grid_cols and hcl_patch.compute_grid_cols(main_x, ratio))
        or math.max(1, math.floor((main_x - 14) / (41 * ratio + 2)))

    local grid
    if hcl_patch and hcl_patch.pack_corpse_stacks_2d then
        grid = hcl_patch.pack_corpse_stacks_2d(stacks, max_cols, npc_id, items_copy)
    else
        grid = { corpse_id = npc_id, max_cols = max_cols, total_cells = #stacks, raw_items = items_copy }
    end

    loot_params.item_grid = grid
    grid_version = grid_version + 1
end

-- @z_func: HCL_Loot.sync_cursor_selection [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT,INVENTORY,PREVIEW,IDLE
local function sync_cursor_selection(reset_to_origin)
    local grid = loot_params.item_grid
    if (loot_state ~= "LOOT" and loot_state ~= "INVENTORY") or not grid or #grid == 0 then
        loot_params.cursor_idx = nil
        loot_params.cursor_object = nil
        return
    end
    if reset_to_origin or loot_params.cursor_idx == nil then
        loot_params.cursor_idx = { row = 1, col = 1 }
    else
        local r = math.max(1, math.min(loot_params.cursor_idx.row, #grid))
        local row_tbl = grid[r]
        local c = math.max(1, math.min(loot_params.cursor_idx.col, #row_tbl))
        loot_params.cursor_idx = { row = r, col = c }
    end
    local sel_row = grid[loot_params.cursor_idx.row]
    local sel_cell = sel_row and sel_row[loot_params.cursor_idx.col] or nil
    loot_params.cursor_object = sel_cell and sel_cell.obj or nil
end

-- @z_func: HCL_Loot.refresh_corpse_grid_if_needed [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT,PREVIEW
local function refresh_corpse_grid_if_needed(npc, tg, reset_cursor)
    if not npc then
        return
    end
    if (not force_grid_rebuild) and (not reset_cursor) and last_grid_checksum ~= nil and tg < next_checksum_tg then
        return
    end
    local checksum, raw_items = build_corpse_checksum(npc, tg)
    next_checksum_tg = tg + 100
    if force_grid_rebuild or reset_cursor or checksum ~= last_grid_checksum then
        force_grid_rebuild = false
        last_grid_checksum = checksum
        rebuild_corpse_item_grid(npc, raw_items)
        sync_cursor_selection(reset_cursor)
    end
end

-- @z_func: HCL_Loot.sync_modifier_key [export:rule:Hover Loot Global Rules] | bind:hcl_loot_scroll_mbc_disassembly_knum | states:LOOT,INVENTORY
function sync_modifier_key()
    if loot_state ~= "LOOT" and loot_state ~= "INVENTORY" then
        loot_params.alt_modifier = false
        return false
    end
    if not mcm_loot_ready then
        refresh_loot_mcm_cache()
    end
    if type(key_state) == "function" then
        if key_state(cached_mod_dik) ~= 0 then
            loot_params.alt_modifier = true
            return true
        else
            loot_params.alt_modifier = false
            return false
        end
    end
    loot_params.alt_modifier = mod_key_fallback_held == true
    return loot_params.alt_modifier
end

-- [SYSTEM] HCL_Loot_Scroll

-- @z [HCL_Loot_Scroll] data:Scroll Wheel Parameters | bind:hcl_loot_scroll_mbc_disassembly_knum
local scroll_wheel_params = {
    s_direction = "DOWN",
}

-- @z_func: HCL_Loot_Scroll.find_matching_col_in_row [internal:Scroll Policy] | bind:hcl_loot_scroll_mbc_disassembly_knum
local function find_matching_col_in_row(target_row, cur_cell)
    if not target_row or #target_row == 0 then
        return 1
    end
    if not cur_cell then
        return 1
    end
    local c_start = cur_cell.col_start or 1
    local c_end = cur_cell.col_end or c_start
    local c_mid = (c_start + c_end) * 0.5
    local best_idx = nil
    local best_dist = 9999
    for idx = 1, #target_row do
        local cand = target_row[idx]
        if cand.col_start <= c_end and cand.col_end >= c_start then
            local cand_mid = (cand.col_start + cand.col_end) * 0.5
            local dist = math.abs(cand_mid - c_mid)
            if dist < best_dist then
                best_dist = dist
                best_idx = idx
            end
        end
    end
    if best_idx then
        return best_idx
    end
    return #target_row
end

-- @z_func: HCL_Loot_Scroll.step_cursor_scroll [export:rule:Scroll Policy] | bind:hcl_loot_scroll_mbc_disassembly_knum
function step_cursor_scroll(is_up)
    scroll_wheel_params.s_direction = is_up and "UP" or "DOWN"
    local grid = loot_params.item_grid
    if loot_state ~= "LOOT" or not grid or #grid == 0 then
        return
    end
    if not loot_params.cursor_idx then
        sync_cursor_selection(true)
        return
    end
    sync_modifier_key()
    local r = loot_params.cursor_idx.row
    local c = loot_params.cursor_idx.col
    local cur_row = grid[r]
    local cur_cell = cur_row and cur_row[c] or nil
    if not loot_params.alt_modifier then
        if is_up then
            if c > 1 then
                c = c - 1
            elseif r > 1 then
                r = r - 1
                c = #grid[r]
            else
                r = #grid
                c = #grid[r]
            end
        else
            if c < #cur_row then
                c = c + 1
            elseif r < #grid then
                r = r + 1
                c = 1
            else
                r = 1
                c = 1
            end
        end
    else
        if is_up then
            r = (r > 1) and (r - 1) or #grid
        else
            r = (r < #grid) and (r + 1) or 1
        end
        c = find_matching_col_in_row(grid[r], cur_cell)
    end
    loot_params.cursor_idx = { row = r, col = c }
    local next_cell = grid[r] and grid[r][c] or nil
    loot_params.cursor_object = next_cell and next_cell.obj or nil
end

-- [SYSTEM] HCL_Loot_MBC

-- @z [HCL_Loot_MBC] data:Mouse Click Parameters | bind:hcl_loot_scroll_mbc_disassembly_knum
local mouse_click_params = {
    s_acceleration = 1.0,
    s_brake_factor = 1.0,
    mbc_debounce = 200,
}

-- @z_func: HCL_Loot_MBC.is_mbc_debounced [export:rule:MBC Trigger rules] | bind:hcl_loot_scroll_mbc_disassembly_knum
function is_mbc_debounced(tg)
    return tg < mbc_debounce_until_tg
end

-- @z_func: HCL_Loot_MBC.transfer_cell_stack [internal:MBC Trigger rules] | bind:hcl_loot_vanilla_transfer_signals
local function transfer_cell_stack(npc, cell)
    if not (npc and db.actor and cell) then
        return false
    end
    local npc_id = npc:id()
    if hcl_patch and not hcl_patch.is_item_revealed(npc_id, cell.id) then
        return false
    end
    local bag_from = EDDListType and EDDListType.iDeadBodyBag or nil
    local moved = false
    local moved_ids = {}
    local items = cell.items or { cell.obj }
    manual_loot_transfer_active = true
    for i = 1, #items do
        local it = items[i]
        if it then
            local flags = { ret_value = true }
            SendScriptCallback("ActorMenu_on_item_before_move", flags, npc_id, it, "loot", bag_from)
            if flags.ret_value ~= false then
                local iid = it:id()
                blacklist_item_id(iid, 850)
                npc:transfer_item(it, db.actor)
                SendScriptCallback("ActorMenu_on_item_after_move", npc_id, it, "loot", bag_from)
                moved_ids[#moved_ids + 1] = iid
                moved = true
            end
        end
    end
    manual_loot_transfer_active = false
    if moved then
        push_ledger_entry(npc_id, moved_ids)
        force_grid_rebuild = true
    end
    return moved
end

-- @z_func: HCL_Loot_MBC.return_cell_stack [internal:MBC Trigger rules] | bind:hcl_loot_vanilla_transfer_signals | states:MBC
local function return_cell_stack(npc, cell)
    if not (npc and db.actor and cell) then
        return false
    end
    local npc_id = npc:id()
    local actor_id = db.actor:id()
    local bag_from = EDDListType and EDDListType.iActorBag or nil
    local returned = false
    local sound_item = nil
    local items = cell.items or { cell.obj }
    for i = 1, #items do
        local it = items[i]
        local iid = it and it:id() or nil
        local live = iid and level.object_by_id(iid) or nil
        local parent = live and live:parent() or nil
        if live and parent and parent:id() == actor_id then
            local flags = { ret_value = true }
            SendScriptCallback("ActorMenu_on_item_before_move", flags, npc_id, live, "loot", bag_from)
            if flags.ret_value ~= false then
                if not sound_item then
                    sound_item = live
                end
                blacklisted_ids[iid] = nil
                db.actor:transfer_item(live, npc)
                SendScriptCallback("ActorMenu_on_item_after_move", npc_id, live, "loot", bag_from)
                remove_ledger_item_id(iid)
                returned = true
            end
        elseif iid then
            remove_ledger_item_id(iid)
        end
    end
    if returned then
        -- CActor::OnItemDrop fires silently on actor->corpse transfer_item; play authentic per-item SFX once per returned stack.
        if sound_item and _G.itms_manager and type(_G.itms_manager.play_item_sound) == "function" then
            _G.itms_manager.play_item_sound(sound_item)
        end
        force_grid_rebuild = true
        last_grid_checksum = nil
        if CreateTimeEvent then
            CreateTimeEvent("hcl_loot_ret", "ret_" .. tostring(npc_id), 0.15, delayed_grid_refresh_cb)
        end
        z_probe(2, "hcl_loot.return_cell_stack", "Returned cell stack to corpse id=%s", tostring(npc_id))
    end
    return returned
end

-- @z_func: HCL_Loot_MBC.transfer_all_revealed_items [internal:MBC] | bind:hcl_loot_scroll_mbc_disassembly_knum | states:MBC
local function transfer_all_revealed_items(npc)
    local grid = loot_params.item_grid
    if not (npc and db.actor and grid) then
        return false
    end
    local npc_id = npc:id()
    local any_moved = false
    for r = 1, #grid do
        local row_tbl = grid[r]
        for c = 1, #row_tbl do
            local cell = row_tbl[c]
            if cell and (not hcl_patch or hcl_patch.is_item_revealed(npc_id, cell.id)) then
                if transfer_cell_stack(npc, cell) then
                    any_moved = true
                end
            end
        end
    end
    return any_moved
end

-- @z_func: HCL_Loot_MBC.wrapped_loot_create_time_event [internal:MBC] | bind:hcl_loot_scroll_mbc_disassembly_knum | states:MBC
local function wrapped_loot_create_time_event(ev_id, act_id, timer, f, ...)
    if disasm_redirect_npc_id and time_global() <= disasm_redirect_until_tg and db.actor and type(ev_id) == "string" and string.find(ev_id, "^delay_disassembly") then
        disasm_intercepted = true
        local a1, a2, a3, a4, a5 = ...
        if a1 == disasm_redirect_npc_id then
            a1 = db.actor:id()
            return orig_loot_create_time_event(ev_id, act_id, timer, f, a1, a2, a3, a4, a5)
        end
    end
    return orig_loot_create_time_event(ev_id, act_id, timer, f, ...)
end

-- @z_func: HCL_Loot_MBC.disassemble_remote_item [internal:MBC] | bind:hcl_loot_scroll_mbc_disassembly_knum | states:MBC
local function disassemble_remote_item(npc, target_obj, tg)
    if not (npc and db.actor and target_obj and _G.item_parts and type(_G.item_parts.func_disassembly) == "function") then
        return false
    end
    local target_id = target_obj:id()
    local prev_ip_d = _G.item_parts.d_flag
    local prev_dit_d = _G.zzz_dit and _G.zzz_dit.d_flag or nil
    local prev_dit_b = _G.zzz_dit and _G.zzz_dit.b_flag or nil
    _G.item_parts.d_flag = true
    if _G.zzz_dit then
        _G.zzz_dit.d_flag = true
        _G.zzz_dit.b_flag = true
    end
    disasm_redirect_npc_id = npc:id()
    disasm_redirect_until_tg = tg + 350
    disasm_intercepted = false
    local ok, err = pcall(_G.item_parts.func_disassembly, target_obj, nil)
    _G.item_parts.d_flag = prev_ip_d
    if _G.zzz_dit then
        _G.zzz_dit.d_flag = prev_dit_d
        _G.zzz_dit.b_flag = prev_dit_b
    end
    if not ok then
        z_probe(1, "hcl_loot.disassemble_remote_item", "func_disassembly error: %s", tostring(err))
        return false
    end
    if disasm_intercepted or (alife_object and alife_object(target_id) == nil) then
        blacklist_item_id(target_id, 850)
    end
    force_grid_rebuild = true
    if CreateTimeEvent then
        CreateTimeEvent("hcl_loot_disasm", "dis_" .. tostring(target_id), 0.22, delayed_grid_refresh_cb)
    end
    return true
end

-- @z_func: HCL_Loot_MBC.step_vaccum_sweep [export:state:Vaccum Sweep] | bind:hcl_loot_scroll_mbc_disassembly_knum | states:Vaccum Sweep
function step_vaccum_sweep(npc, is_up, tg)
    mbc_state = "Vaccum Sweep"
    sweep_triggered_this_hold = true
    if tg - last_wheel_tg <= 140 then
        wheel_burst_vel = math.min(wheel_burst_vel + 1, 8)
    else
        wheel_burst_vel = 1
    end
    last_wheel_tg = tg
    if tg < sweep_brake_until_tg then
        return
    end
    local s_accel = (hcl_mcm and tonumber(hcl_mcm.get_config("hcl_mcm_scroll_acceleration"))) or 1.0
    mouse_click_params.s_acceleration = s_accel
    local steps = math.max(1, math.floor(wheel_burst_vel ^ s_accel))
    local npc_id = npc and npc:id() or nil

    for _ = 1, steps do
        local grid = loot_params.item_grid
        if not (npc and grid and #grid > 0 and loot_params.cursor_idx) then
            break
        end
        local r = loot_params.cursor_idx.row
        local c = loot_params.cursor_idx.col
        local cur_row = grid[r]
        local cell = cur_row and cur_row[c] or nil
        if not cell then
            break
        end
        local was_row_len = #cur_row
        local revealed = (not hcl_patch) or hcl_patch.is_item_revealed(npc_id, cell.id)
        if revealed then
            transfer_cell_stack(npc, cell)
            refresh_corpse_grid_if_needed(npc, tg, false)
            local new_grid = loot_params.item_grid
            if not new_grid or #new_grid == 0 then
                break
            end
            if not is_up then
                if was_row_len <= 1 or c > (was_row_len - 1) then
                    local next_r = (was_row_len <= 1) and math.min(r, #new_grid) or ((r < #new_grid) and (r + 1) or 1)
                    loot_params.cursor_idx = { row = next_r, col = 1 }
                    sync_cursor_selection(false)
                    sweep_brake_until_tg = tg + math.floor(240 * mouse_click_params.s_brake_factor)
                    break
                else
                    local stay_r = math.min(r, #new_grid)
                    local stay_c = math.min(c, #new_grid[stay_r])
                    loot_params.cursor_idx = { row = stay_r, col = stay_c }
                    sync_cursor_selection(false)
                end
            else
                if was_row_len <= 1 or c <= 1 then
                    local prev_r = (r > 1) and (r - 1) or #new_grid
                    loot_params.cursor_idx = { row = prev_r, col = #new_grid[prev_r] }
                    sync_cursor_selection(false)
                    sweep_brake_until_tg = tg + math.floor(240 * mouse_click_params.s_brake_factor)
                    break
                else
                    local stay_r = math.min(r, #new_grid)
                    local stay_c = math.min(c - 1, #new_grid[stay_r])
                    loot_params.cursor_idx = { row = stay_r, col = stay_c }
                    sync_cursor_selection(false)
                end
            end
        else
            local next_c = is_up and (c - 1) or (c + 1)
            if next_c < 1 or next_c > #cur_row then
                local next_r
                if is_up then
                    next_r = (r > 1) and (r - 1) or #grid
                    next_c = #grid[next_r]
                else
                    next_r = (r < #grid) and (r + 1) or 1
                    next_c = 1
                end
                loot_params.cursor_idx = { row = next_r, col = next_c }
                sync_cursor_selection(false)
                sweep_brake_until_tg = tg + math.floor(240 * mouse_click_params.s_brake_factor)
                break
            else
                loot_params.cursor_idx = { row = r, col = next_c }
                sync_cursor_selection(false)
            end
        end
    end
end

-- @z_func: HCL_Loot_MBC.enter_mbc_ready [export:state:MBC] | bind:hcl_loot_scroll_mbc_disassembly_knum | states:MBC
function enter_mbc_ready()
    mbc_state = "MBC"
    if not lmb_held then
        sweep_brake_until_tg = 0
        wheel_burst_vel = 0
    end
end

-- @z_func: HCL_Loot_MBC.handle_lmb_release [export:state:MBC] | bind:hcl_loot_scroll_mbc_disassembly_knum | states:MBC,Vaccum Sweep
function handle_lmb_release(npc, tg)
    local had_sweep = (mbc_state == "Vaccum Sweep") or sweep_triggered_this_hold
    local was_pressed = lmb_pressed_in_loot
    lmb_held = false
    lmb_pressed_in_loot = false
    sweep_triggered_this_hold = false
    enter_mbc_ready()
    if had_sweep or (not was_pressed) or is_mbc_debounced(tg) then
        return
    end
    local idx = loot_params.cursor_idx
    local obj = loot_params.cursor_object
    local grid = loot_params.item_grid
    if not (npc and idx and obj and grid and grid[idx.row] and grid[idx.row][idx.col]) then
        return
    end
    local cell = grid[idx.row][idx.col]
    sync_modifier_key()
    if loot_state == "INVENTORY" then
        if loot_params.alt_modifier then
            return
        end
        mbc_debounce_until_tg = tg + mouse_click_params.mbc_debounce
        if return_cell_stack(npc, cell) then
            enter_loot_inventory(npc, tg)
        end
        return
    end
    local npc_id = npc:id()
    if hcl_patch and not hcl_patch.is_item_revealed(npc_id, cell.id) then
        return
    end
    mbc_debounce_until_tg = tg + mouse_click_params.mbc_debounce
    if loot_params.alt_modifier then
        if hcl_patch and hcl_patch.can_field_strip(obj) then
            local orig_id = obj:id()
            local did_strip, res_id = hcl_patch.field_strip_weapon(obj, npc)
            if did_strip then
                if res_id and res_id ~= orig_id then
                    blacklist_item_id(orig_id, 850)
                end
                force_grid_rebuild = true
                refresh_corpse_grid_if_needed(npc, tg, false)
            end
        elseif hcl_patch and hcl_patch.is_loaded_magazine(obj) then
            if hcl_patch.unload_magazine(obj, npc) then
                force_grid_rebuild = true
                refresh_corpse_grid_if_needed(npc, tg, false)
            end
        end
    else
        if transfer_cell_stack(npc, cell) then
            refresh_corpse_grid_if_needed(npc, tg, false)
        end
    end
end

-- @z_func: HCL_Loot_MBC.handle_rmb_release [export:state:MBC] | bind:hcl_loot_scroll_mbc_disassembly_knum | states:MBC
function handle_rmb_release(npc, tg)
    local was_pressed = rmb_pressed_in_loot
    rmb_pressed_in_loot = false
    if (not was_pressed) or is_mbc_debounced(tg) then
        return
    end
    local idx = loot_params.cursor_idx
    local obj = loot_params.cursor_object
    if not (npc and idx and obj) then
        return
    end
    sync_modifier_key()
    mbc_debounce_until_tg = tg + mouse_click_params.mbc_debounce
    if loot_params.alt_modifier then
        if not hcl_patch or hcl_patch.is_item_revealed(npc:id(), obj:id()) then
            if disassemble_remote_item(npc, obj, tg) then
                refresh_corpse_grid_if_needed(npc, tg, false)
            end
        end
    else
        if hcl_patch and hcl_patch.is_autolooter_active() then
            if hcl_patch.run_autolooter(npc) then
                force_grid_rebuild = true
                if CreateTimeEvent then
                    CreateTimeEvent("hcl_loot_ial", "ial_" .. tostring(npc:id()), 0.20, delayed_grid_refresh_cb)
                end
                refresh_corpse_grid_if_needed(npc, tg, false)
            end
        else
            if transfer_all_revealed_items(npc) then
                refresh_corpse_grid_if_needed(npc, tg, false)
            end
        end
    end
end

-- [SYSTEM] HCL_Loot_KNum

-- @z_func: HCL_Loot_KNum.get_number_key_index [internal:Jump Row] | bind:hcl_loot_scroll_mbc_disassembly_knum
local function get_number_key_index(key)
    if not DIK_keys then
        if key >= 2 and key <= 6 then
            return key - 1
        end
        return nil
    end
    if key == DIK_keys.DIK_1 or key == DIK_keys.DIK_NUMPAD1 then return 1 end
    if key == DIK_keys.DIK_2 or key == DIK_keys.DIK_NUMPAD2 then return 2 end
    if key == DIK_keys.DIK_3 or key == DIK_keys.DIK_NUMPAD3 then return 3 end
    if key == DIK_keys.DIK_4 or key == DIK_keys.DIK_NUMPAD4 then return 4 end
    if key == DIK_keys.DIK_5 or key == DIK_keys.DIK_NUMPAD5 then return 5 end
    return nil
end

-- @z_func: HCL_Loot_KNum.jump_cursor_row [export:rule:Jump Row] | bind:hcl_loot_scroll_mbc_disassembly_knum
function jump_cursor_row(base_num)
    local grid = loot_params.item_grid
    if loot_state ~= "LOOT" or not grid or #grid == 0 or not base_num then
        return
    end
    sync_modifier_key()
    local slot_idx = loot_params.alt_modifier and (base_num + 5) or base_num
    local jump_type = (hcl_mcm and hcl_mcm.get_config("hcl_mcm_jump_type")) or "ExactRow"
    local cur_idx = loot_params.cursor_idx or { row = 1, col = 1 }

    if jump_type == "ExactRow" or jump_type == "Exact Row" then
        if slot_idx >= 1 and slot_idx <= #grid then
            loot_params.cursor_idx = { row = slot_idx, col = 1 }
            sync_cursor_selection(false)
        end
        return
    end

    if not hcl_patch then
        return
    end
    local match_rows = {}
    for r = 1, #grid do
        local row_tbl = grid[r]
        for c = 1, #row_tbl do
            local cell = row_tbl[c]
            if cell and cell.obj and hcl_patch.does_item_match_jump_slot(cell.obj, slot_idx) then
                match_rows[#match_rows + 1] = r
                break
            end
        end
    end
    if #match_rows == 0 then
        return
    end
    local chosen_row = match_rows[1]
    if #match_rows > 1 then
        for i = 1, #match_rows do
            if match_rows[i] == cur_idx.row then
                chosen_row = match_rows[(i % #match_rows) + 1]
                break
            end
        end
    end
    loot_params.cursor_idx = { row = chosen_row, col = 1 }
    sync_cursor_selection(false)
end

-- @z_func: HCL_Loot.enter_loot_idle [export:state:IDLE] | bind:hcl_loot_phase2_rewards_and_se_storage | states:IDLE
function enter_loot_idle()
    local was_active = (loot_state ~= "IDLE")
    loot_state = "IDLE"
    loot_params.item_grid = {}
    loot_params.cursor_idx = nil
    loot_params.cursor_object = nil
    loot_params.alt_modifier = false
    loot_params.corpse_looted = false
    active_corpse_id = nil
    last_grid_checksum = nil
    last_inv_grid_key = nil
    mbc_debounce_until_tg = 0
    lmb_held = false
    lmb_pressed_in_loot = false
    rmb_pressed_in_loot = false
    sweep_triggered_this_hold = false
    sweep_brake_until_tg = 0
    wheel_burst_vel = 0
    mod_key_fallback_held = false
    peek_hold_fallback = false
    peek_edge_held = false
    peek_toggle_active = false
    enter_mbc_ready()
    if was_active then
        grid_version = grid_version + 1
        z_probe(2, "hcl_loot.enter_loot_idle", "Entered IDLE and restored weapon controls")
    end
end

-- @z_func: HCL_Loot.is_quick_peek_active [internal:INVENTORY] | bind:hcl_loot_quick_peek_keybind | states:INVENTORY,LOOT
local function is_quick_peek_active()
    if not mcm_loot_ready then
        refresh_loot_mcm_cache()
    end
    if cached_peek_dik <= 0 then
        return false
    end
    if cached_peek_scheme == "Toggle" then
        return peek_toggle_active == true
    end
    if type(key_state) == "function" then
        return key_state(cached_peek_dik) ~= 0
    end
    return peek_hold_fallback == true
end

-- @z_func: HCL_Loot.rebuild_inventory_item_grid [internal:INVENTORY] | bind:hcl_loot_looted_items_lifecycle | states:INVENTORY
local function rebuild_inventory_item_grid(npc, tg)
    local npc_id = npc:id()
    prune_live_ledger(tg)
    local stacks = {}
    local raw_items = {}
    -- Walk LIFO stack from newest (#stack) down to oldest (1) so most recently looted items appear first.
    for idx = #looted_ledger.stack, 1, -1 do
        local grp_ids = looted_ledger.stack[idx]
        local valid_objs = {}
        local valid_ids = {}
        for j = 1, #grp_ids do
            local iid = grp_ids[j]
            local obj = iid and level.object_by_id(iid) or nil
            if obj then
                valid_objs[#valid_objs + 1] = obj
                valid_ids[#valid_ids + 1] = iid
                raw_items[#raw_items + 1] = obj
            end
        end
        if #valid_objs > 0 then
            local obj = valid_objs[1]
            local sec = obj:section()
            local gw, gh
            if hcl_patch and hcl_patch.get_effective_grid_wh then
                gw, gh = hcl_patch.get_effective_grid_wh(sec)
            else
                gw = math.max(1, math.floor((ini_sys:r_float_ex(sec, "inv_grid_width", 1) or 1) + 0.5))
                gh = math.max(1, math.floor((ini_sys:r_float_ex(sec, "inv_grid_height", 1) or 1) + 0.5))
            end
            local cat_rank = (hcl_patch and hcl_patch.get_item_category_rank(obj, sec))
                or (SYS_GetParam and SYS_GetParam(0, sec, "kind", "na"))
                or 999
            stacks[#stacks + 1] = {
                obj = obj,
                id = obj:id(),
                sec = sec,
                items = valid_objs,
                ids = valid_ids,
                grid_w = gw,
                grid_h = gh,
                cat_rank = cat_rank,
            }
        end
    end

    local main_x = (hcl_mcm and tonumber(hcl_mcm.get_config("hcl_mcm_ui_main_x"))) or 300
    local ratio = (_G.utils_xml and _G.utils_xml.screen_ratio and _G.utils_xml.screen_ratio()) or 0.75
    local max_cols = (hcl_patch and hcl_patch.compute_grid_cols and hcl_patch.compute_grid_cols(main_x, ratio))
        or math.max(1, math.floor((main_x - 14) / (41 * ratio + 2)))

    local grid
    if hcl_patch and hcl_patch.pack_corpse_stacks_2d then
        grid = hcl_patch.pack_corpse_stacks_2d(stacks, max_cols, npc_id, raw_items)
    else
        grid = { corpse_id = npc_id, max_cols = max_cols, total_cells = #stacks, raw_items = raw_items }
    end
    grid.is_inventory = true
    loot_params.item_grid = grid
    grid_version = grid_version + 1
end

-- @z_func: HCL_Loot.enter_loot_inventory [export:state:INVENTORY] | bind:hcl_loot_looted_items_lifecycle | states:INVENTORY
function enter_loot_inventory(npc, tg)
    local npc_id = npc:id()
    local entering = (loot_state ~= "INVENTORY") or (active_corpse_id ~= npc_id)
    if entering then
        last_inv_grid_key = nil
        lmb_held = false
        lmb_pressed_in_loot = false
        rmb_pressed_in_loot = false
        sweep_triggered_this_hold = false
        sweep_brake_until_tg = 0
        enter_mbc_ready()
    end
    loot_state = "INVENTORY"
    active_corpse_id = npc_id
    loot_params.corpse_looted = read_native_corpse_looted(npc)
    sync_modifier_key()

    if tg >= next_inv_prune_tg then
        next_inv_prune_tg = tg + 150
        prune_live_ledger(tg)
    end
    if looted_ledger.corpse_id ~= npc_id or #looted_ledger.stack == 0 then
        peek_toggle_active = false
        enter_loot_active(npc, tg)
        return
    end

    local main_x = (hcl_mcm and tonumber(hcl_mcm.get_config("hcl_mcm_ui_main_x"))) or 300
    local patch_seq = (hcl_patch and hcl_patch.get_patch_dirty_seq()) or 0
    local inv_key = string.format("%d:%d:%d:%d", npc_id, loot_ledger_seq, main_x, patch_seq)
    if entering or inv_key ~= last_inv_grid_key then
        rebuild_inventory_item_grid(npc, tg)
        last_inv_grid_key = string.format("%d:%d:%d:%d", npc_id, loot_ledger_seq, main_x, patch_seq)
        if #loot_params.item_grid == 0 then
            peek_toggle_active = false
            enter_loot_active(npc, tg)
            return
        end
        sync_cursor_selection(entering)
    end
    if entering then
        z_probe(2, "hcl_loot.enter_loot_inventory", "Entered INVENTORY quick peek on corpse id=%s (entries=%d)", tostring(npc_id), #looted_ledger.stack)
    end
end

-- @z_func: HCL_Loot.enter_loot_active [export:state:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT
function enter_loot_active(npc, tg)
    local npc_id = npc:id()
    local was_inventory = (loot_state == "INVENTORY")
    local entering_or_swapped = (loot_state ~= "LOOT") or (active_corpse_id ~= npc_id)
    if looted_ledger.corpse_id ~= nil and looted_ledger.corpse_id ~= npc_id then
        clear_looted_ledger("corpse_swap")
        peek_toggle_active = false
    end
    if active_corpse_id ~= npc_id or was_inventory then
        last_grid_checksum = nil
        force_grid_rebuild = true
        lmb_held = false
        lmb_pressed_in_loot = false
        rmb_pressed_in_loot = false
        sweep_triggered_this_hold = false
        sweep_brake_until_tg = 0
        enter_mbc_ready()
    end
    loot_state = "LOOT"
    active_corpse_id = npc_id
    if entering_or_swapped then
        transfer_corpse_quest_info(npc)
        execute_phase2_corpse_rewards(npc)
        z_probe(2, "hcl_loot.enter_loot_active", "Entered LOOT on corpse id=%s", tostring(npc_id))
    else
        loot_params.corpse_looted = read_native_corpse_looted(npc)
    end
    sync_modifier_key()
    if lmb_held and type(key_state) == "function" then
        local m1 = MOUSE_1 or (DIK_keys and DIK_keys.MOUSE_1) or 337
        if key_state(m1) == 0 then
            lmb_held = false
            lmb_pressed_in_loot = false
            sweep_triggered_this_hold = false
            enter_mbc_ready()
        end
    end
    refresh_corpse_grid_if_needed(npc, tg, entering_or_swapped)
end

-- @z_func: HCL_Loot.enter_loot_preview [export:state:PREVIEW] | bind:hcl_loot_phase2_rewards_and_se_storage | states:PREVIEW
function enter_loot_preview(npc, tg)
    local npc_id = npc:id()
    if active_corpse_id ~= npc_id then
        last_grid_checksum = nil
    end
    loot_state = "PREVIEW"
    active_corpse_id = npc_id
    loot_params.cursor_idx = nil
    loot_params.cursor_object = nil
    loot_params.alt_modifier = false
    lmb_held = false
    lmb_pressed_in_loot = false
    rmb_pressed_in_loot = false
    sweep_triggered_this_hold = false
    sweep_brake_until_tg = 0
    enter_mbc_ready()
    loot_params.corpse_looted = read_native_corpse_looted(npc)
    refresh_corpse_grid_if_needed(npc, tg, false)
end

-- @z_func: HCL_Loot.sync_loot_transition_if_needed [internal:Cursor Parameters] | bind:hcl_loot_looted_items_lifecycle
local function sync_loot_transition_if_needed()
    local corpse_status = (hcl_main and hcl_main.get_corpse_check_status()) or "INVALID"
    local cb_status = (hcl_main and hcl_main.get_callback_status()) or "IDLE"
    local claimed = (hcl_patch and hcl_patch.is_claimed()) or false
    local corpse = (corpse_status == "VALID" and hcl_main) and hcl_main.get_hovered_corpse() or nil
    if corpse_status ~= "VALID" or (cb_status ~= "PREVIEW" and cb_status ~= "LOOT") or claimed or not corpse then
        if loot_state ~= "IDLE" then
            actor_on_update()
        end
        return
    end
    local cid = corpse:id()
    if cb_status == "PREVIEW" then
        if loot_state ~= "PREVIEW" or active_corpse_id ~= cid then
            actor_on_update()
        end
        return
    end
    local want_inv = (looted_ledger.corpse_id == cid and #looted_ledger.stack > 0 and is_quick_peek_active())
    local expected = want_inv and "INVENTORY" or "LOOT"
    if loot_state ~= expected or active_corpse_id ~= cid then
        actor_on_update()
    end
end

-- @z_func: HCL_Loot.get_item_grid [export:output:Cursor Parameters] | bind:hcl_loot_phase2_rewards_and_se_storage
function get_item_grid()
    sync_loot_transition_if_needed()
    return loot_params.item_grid
end

-- @z_func: HCL_Loot.get_cursor_idx [export:output:Cursor Parameters] | bind:hcl_loot_phase2_rewards_and_se_storage
function get_cursor_idx()
    return loot_params.cursor_idx
end

-- @z_func: HCL_Loot.get_cursor_object [export:output:Cursor Parameters] | bind:hcl_loot_phase2_rewards_and_se_storage
function get_cursor_object()
    return loot_params.cursor_object
end

-- @z_func: HCL_Loot.is_corpse_looted [export:output:Cursor Parameters] | bind:hcl_loot_phase2_rewards_and_se_storage
function is_corpse_looted()
    return loot_params.corpse_looted == true
end

-- @z_func: HCL_Loot.get_grid_version [export:output:Cursor Parameters] | bind:hcl_loot_phase2_rewards_and_se_storage
function get_grid_version()
    return grid_version
end

-- @z_func: HCL_Loot.has_looted_items [export:output:Cursor Parameters] | bind:hcl_loot_looted_items_lifecycle
function has_looted_items(corpse_id)
    local target_id = corpse_id or active_corpse_id
    if target_id == nil or looted_ledger.corpse_id ~= target_id or #looted_ledger.stack == 0 then
        return false
    end
    return prune_live_ledger(time_global()) > 0 and looted_ledger.corpse_id == target_id
end

-- @z_func: HCL_Loot.get_looted_items [export:output:Cursor Parameters] | bind:hcl_loot_looted_items_lifecycle
function get_looted_items()
    return loot_params.looted_items
end

-- @z_func: HCL_Loot.get_loot_mode [export:output:Cursor Parameters] | bind:hcl_loot_looted_items_lifecycle
function get_loot_mode()
    sync_loot_transition_if_needed()
    return loot_state
end

-- @z_func: HCL_Loot.is_inventory_mode [export:output:Cursor Parameters] | bind:hcl_loot_looted_items_lifecycle
function is_inventory_mode()
    return get_loot_mode() == "INVENTORY"
end

-- @z_func: HCL_Loot.is_lmb_key [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT
local function is_lmb_key(key)
    return (MOUSE_1 ~= nil and key == MOUSE_1) or (DIK_keys ~= nil and DIK_keys.MOUSE_1 ~= nil and key == DIK_keys.MOUSE_1) or key == 337
end

-- @z_func: HCL_Loot.is_rmb_key [internal:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT
local function is_rmb_key(key)
    return (MOUSE_2 ~= nil and key == MOUSE_2) or (DIK_keys ~= nil and DIK_keys.MOUSE_2 ~= nil and key == DIK_keys.MOUSE_2) or key == 338
end

-- @z_func: HCL_Loot.ensure_loot_hooks [internal:shared] | bind:hcl_loot_scroll_mbc_disassembly_knum
local function ensure_loot_hooks()
    if loot_hooks_installed then
        return
    end
    loot_hooks_installed = true
    if type(_G.CreateTimeEvent) == "function" then
        orig_loot_create_time_event = _G.CreateTimeEvent
        _G.CreateTimeEvent = wrapped_loot_create_time_event
    end
end

-- @z_func: HCL_Loot.GUI_on_show [export:callback:LOOT] | bind:hcl_loot_phase2_rewards_and_se_storage | states:LOOT,PREVIEW,IDLE
function GUI_on_show(name)
    if name ~= "UIInventory" or not (_G.ui_inventory and _G.ui_inventory.GUI) then
        return
    end
    local gui = _G.ui_inventory.GUI
    if gui.mode ~= "loot" or not gui.npc_id then
        return
    end
    local npc = level.object_by_id(gui.npc_id)
    if not (npc and IsStalker(npc) and not npc:alive()) then
        return
    end
    local id = npc:id()
    local npc_name = npc:name()
    if se_load_var and se_load_var(id, npc_name, "hcl_phase1_only") == true and not se_load_var(id, npc_name, "hcl_looted") then
        if se_save_var then
            se_save_var(id, npc_name, "hcl_looted", true)
            se_save_var(id, npc_name, "hcl_phase1_only", false)
        end
        if _G.item_money and type(_G.item_money.actor_on_loot_money) == "function" then
            _G.item_money.actor_on_loot_money(npc)
        end
        if character_community then
            SendScriptCallback("actor_on_interaction", "factions", nil, character_community(npc))
        end
        flush_scavenger_for_corpse(npc, id, npc_name)
    end
end

-- @z_func: HCL_Loot.on_before_key_press [export:callback:LOOT] | bind:hcl_loot_quick_peek_keybind | states:LOOT,INVENTORY
function on_before_key_press(key, bind, dis, flags)
    if not mcm_loot_ready then
        refresh_loot_mcm_cache()
    end
    if key == cached_mod_dik then
        mod_key_fallback_held = true
    end
    -- Never swallow cached_peek_dik (e.g. Left Shift sprint must continue working uninterrupted).
    if loot_state ~= "LOOT" and loot_state ~= "INVENTORY" then
        return
    end
    if is_lmb_key(key) then
        lmb_held = true
        lmb_pressed_in_loot = true
        sweep_triggered_this_hold = false
        sweep_brake_until_tg = 0
        if flags then flags.ret_value = false end
        return
    end
    if is_rmb_key(key) then
        rmb_pressed_in_loot = (loot_state == "LOOT")
        if flags then flags.ret_value = false end
        return
    end
    if get_number_key_index(key) ~= nil then
        if flags then flags.ret_value = false end
        return
    end
    if key_bindings and bind then
        if bind == key_bindings.kWPN_FIRE
            or bind == key_bindings.kWPN_ZOOM
            or bind == key_bindings.kWPN_NEXT
            or bind == key_bindings.kWPN_PREV
            or bind == key_bindings.kWPN_1
            or bind == key_bindings.kWPN_2
            or bind == key_bindings.kWPN_3
            or bind == key_bindings.kWPN_4
            or bind == key_bindings.kWPN_5
            or bind == key_bindings.kWPN_6 then
            if flags then flags.ret_value = false end
        end
    end
end

-- @z_func: HCL_Loot.on_key_press [export:callback:Hover Loot Global Rules] | bind:hcl_loot_quick_peek_keybind | states:LOOT,INVENTORY
function on_key_press(key)
    if not mcm_loot_ready then
        refresh_loot_mcm_cache()
    end
    if key == cached_mod_dik then
        mod_key_fallback_held = true
    end
    if cached_peek_dik > 0 and key == cached_peek_dik then
        peek_hold_fallback = true
        if not peek_edge_held then
            peek_edge_held = true
            if cached_peek_scheme == "Toggle" then
                if loot_state == "INVENTORY" then
                    peek_toggle_active = false
                elseif loot_state == "LOOT" and active_corpse_id ~= nil and has_looted_items(active_corpse_id) then
                    peek_toggle_active = true
                end
            end
        end
    end
end

-- @z_func: HCL_Loot.on_key_release [export:callback:LOOT] | bind:hcl_loot_quick_peek_keybind | states:LOOT,INVENTORY
function on_key_release(key)
    if not mcm_loot_ready then
        refresh_loot_mcm_cache()
    end
    if key == cached_mod_dik then
        mod_key_fallback_held = false
    end
    if cached_peek_dik > 0 and key == cached_peek_dik then
        peek_hold_fallback = false
        peek_edge_held = false
    end
    if is_lmb_key(key) then
        if loot_state == "LOOT" or loot_state == "INVENTORY" then
            local npc = hcl_main and hcl_main.get_hovered_corpse() or nil
            handle_lmb_release(npc, time_global())
        else
            lmb_held = false
            lmb_pressed_in_loot = false
            sweep_triggered_this_hold = false
            enter_mbc_ready()
        end
        return
    end
    if is_rmb_key(key) then
        if loot_state == "LOOT" then
            local npc = hcl_main and hcl_main.get_hovered_corpse() or nil
            handle_rmb_release(npc, time_global())
        else
            rmb_pressed_in_loot = false
        end
        return
    end
    if loot_state == "LOOT" then
        local num_idx = get_number_key_index(key)
        if num_idx ~= nil then
            jump_cursor_row(num_idx)
        end
    end
end

-- @z_func: HCL_Loot.on_mouse_wheel [export:callback:LOOT] | bind:hcl_loot_scroll_mbc_disassembly_knum | states:LOOT,INVENTORY
function on_mouse_wheel(dir, flags)
    if loot_state == "PREVIEW" then
        -- Suppress weapon slot cycling on the wheel tick that unlocks PREVIEW -> LOOT in hcl_main.
        if type(flags) == "table" then
            flags.ret_value = false
        end
        return
    end
    if loot_state == "INVENTORY" then
        if type(flags) == "table" then
            flags.ret_value = false
        end
        if not lmb_held then
            local is_up = (dir == 1 or dir == true)
            -- Delegate to hash-locked step_cursor_scroll without mutating its body; Vacuum Sweep is ignored in INVENTORY.
            loot_state = "LOOT"
            step_cursor_scroll(is_up)
            loot_state = "INVENTORY"
        end
        return
    end
    if loot_state ~= "LOOT" then
        return
    end
    if type(flags) == "table" then
        flags.ret_value = false
    end
    local is_up = (dir == 1 or dir == true)
    local tg = time_global()
    if lmb_held then
        local npc = hcl_main and hcl_main.get_hovered_corpse() or nil
        step_vaccum_sweep(npc, is_up, tg)
    else
        step_cursor_scroll(is_up)
    end
end

-- @z_func: HCL_Loot.on_option_change [export:callback:Hover Loot Global Rules] | bind:hcl_loot_quick_peek_keybind
function on_option_change()
    mcm_loot_ready = false
end

-- @z_func: HCL_Loot.actor_on_item_drop [export:callback:Hover Loot Global Rules] | bind:hcl_loot_looted_items_lifecycle
function actor_on_item_drop(item)
    if not item then
        return
    end
    remove_ledger_item_id(item:id())
end

-- @z_func: HCL_Loot.actor_on_item_take [export:callback:Hover Loot Global Rules] | bind:hcl_loot_looted_items_lifecycle
function actor_on_item_take(item)
    if manual_loot_transfer_active or not item then
        return
    end
    if (loot_state == "LOOT" or loot_state == "INVENTORY") and active_corpse_id ~= nil and corpse_snapshot_npc_id == active_corpse_id then
        local iid = item:id()
        if corpse_snapshot_ids[iid] == true and not looted_ledger.ids[iid] then
            push_ledger_entry(active_corpse_id, { iid })
        end
    end
end

-- @z_func: HCL_Loot.server_entity_on_unregister [export:callback:Hover Loot Global Rules] | bind:hcl_loot_looted_items_lifecycle
function server_entity_on_unregister(se_obj, type_name)
    if not se_obj then
        return
    end
    local sid = se_obj.id
    if sid == nil then
        return
    end
    if looted_ledger.corpse_id == sid then
        peek_toggle_active = false
        clear_looted_ledger("corpse_unregistered")
    elseif looted_ledger.ids[sid] then
        remove_ledger_item_id(sid)
    end
end

-- @z_func: HCL_Loot.actor_on_before_death [export:callback:Hover Loot Global Rules] | bind:hcl_loot_looted_items_lifecycle
function actor_on_before_death()
    peek_hold_fallback = false
    peek_edge_held = false
    peek_toggle_active = false
    clear_looted_ledger("actor_death")
end

-- @z_func: HCL_Loot.actor_on_net_destroy [export:callback:Hover Loot Global Rules] | bind:hcl_loot_looted_items_lifecycle
function actor_on_net_destroy()
    peek_hold_fallback = false
    peek_edge_held = false
    peek_toggle_active = false
    clear_looted_ledger("net_destroy")
end

-- @z_func: HCL_Loot.actor_on_update [export:callback:Cursor Parameters] | bind:hcl_loot_phase2_rewards_and_se_storage | states:IDLE,INVENTORY,LOOT,PREVIEW
function actor_on_update()
    if not loot_hooks_installed then
        ensure_loot_hooks()
    end
    if not mcm_loot_ready then
        refresh_loot_mcm_cache()
    end
    local corpse_status = (hcl_main and hcl_main.get_corpse_check_status()) or "INVALID"
    local cb_status = (hcl_main and hcl_main.get_callback_status()) or "IDLE"
    local claimed = (hcl_patch and hcl_patch.is_claimed()) or false
    local corpse = (corpse_status == "VALID" and hcl_main) and hcl_main.get_hovered_corpse() or nil

    if corpse_status ~= "VALID" or (cb_status ~= "PREVIEW" and cb_status ~= "LOOT") or claimed or not corpse then
        enter_loot_idle()
        return
    end
    local tg = time_global()
    if cb_status == "LOOT" then
        local cid = corpse:id()
        if looted_ledger.corpse_id ~= nil and looted_ledger.corpse_id ~= cid then
            clear_looted_ledger("corpse_swap")
            peek_toggle_active = false
        end
        if is_quick_peek_active() and has_looted_items(cid) then
            enter_loot_inventory(corpse, tg)
        else
            if peek_toggle_active and not has_looted_items(cid) then
                peek_toggle_active = false
            end
            enter_loot_active(corpse, tg)
        end
    else
        enter_loot_preview(corpse, tg)
    end
end

-- @z_func: HCL_Loot.on_game_start [export:callback:Cursor Parameters] | bind:hcl_loot_phase2_rewards_and_se_storage
function on_game_start()
    -- Defer MCM cache hydration until actor_on_first_update so axr_main.config values are live rather than module-load defaults.
    RegisterScriptCallback("actor_on_first_update", on_option_change)
    RegisterScriptCallback("GUI_on_show", GUI_on_show)
    RegisterScriptCallback("on_option_change", on_option_change)
    RegisterScriptCallback("on_before_key_press", on_before_key_press)
    RegisterScriptCallback("on_key_press", on_key_press)
    RegisterScriptCallback("on_key_release", on_key_release)
    RegisterScriptCallback("on_mouse_wheel", on_mouse_wheel)
    RegisterScriptCallback("actor_on_item_drop", actor_on_item_drop)
    RegisterScriptCallback("actor_on_item_take", actor_on_item_take)
    RegisterScriptCallback("server_entity_on_unregister", server_entity_on_unregister)
    RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
    RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
    RegisterScriptCallback("actor_on_update", actor_on_update)
end
