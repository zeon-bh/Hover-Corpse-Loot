local debug_level = 0 -- 0=OFF, 1=ERROR, 2=WARN/STATE, 3=VERBOSE

---------------------------------------------------------------------------------------
-- Outputs formatted chokepoint diagnostic telemetry to the X-Ray console log.
-- Arguments: level (number) - Severity threshold (1=ERROR, 2=WARN/STATE, 3=VERBOSE)
--            station (string) - Name of the executing system or function
--            msg (string) - Format string or message
--            ... (any) - Optional format arguments passed to string.format
-- Returns: (nil)
---------------------------------------------------------------------------------------
local function z_probe(level, station, msg, ...)
    if level > debug_level then return end
    local ok, formatted = pcall(string.format, msg, ...)
    printf("[Hover Corpse Loot] | %s | %s", tostring(station), ok and formatted or tostring(msg))
end

-- [SYSTEM] HCL_Main

local corpse_check_status = "INVALID"
local callback_status = "IDLE"
local hovered_corpse = nil
local hovered_corpse_id = nil

local looted_corpses = {}

-- [SYSTEM] HCL_CorpseCheck

local POLL_INTERVAL_MS = 50
local next_poll_tg = 0
local cached_ray = nil
local cached_ray_dist = nil
local cached_ray_actor_id = nil

---------------------------------------------------------------------------------------
-- Checks whether any conflicting fullscreen UI or inventory mode is currently open.
-- Arguments: none
-- Returns: (boolean) - True if the main HUD is free for Hover Corpse Loot display
---------------------------------------------------------------------------------------
function is_hud_ready()
    if not db.actor then return false end
    if not main_hud_shown() then return false end
    if actor_menu and actor_menu.get_last_mode and actor_menu.get_last_mode() ~= 0 then
        return false
    end
    return true
end

---------------------------------------------------------------------------------------
-- Ensures the cached demonized_geometry_ray instance matches the current max distance.
-- Arguments: max_dist (number) - Maximum raycast range in meters from MCM
-- Returns: (table|nil) - Geometry ray instance or nil if demonized_geometry_ray is absent
---------------------------------------------------------------------------------------
local function get_or_create_ray(max_dist)
    if not demonized_geometry_ray or not demonized_geometry_ray.geometry_ray then
        return nil
    end
    local actor_id = db.actor and db.actor:id() or nil
    if (not cached_ray) or (cached_ray_dist ~= max_dist) or (cached_ray_actor_id ~= actor_id) then
        cached_ray = demonized_geometry_ray.geometry_ray({
            ray_range = max_dist,
            contact_range = max_dist,
            flags = 3,
            ignore_object = db.actor,
        })
        cached_ray_dist = max_dist
        cached_ray_actor_id = actor_id
    end
    return cached_ray
end

---------------------------------------------------------------------------------------
-- Evaluates read-only whether a dead stalker corpse is claimed by a live NPC in GAMMA.
-- Arguments: npc (game_object) - Target dead stalker game object
-- Returns: (boolean) - True if the corpse is claimed by a live stalker, false otherwise
---------------------------------------------------------------------------------------
function is_corpse_claimed(npc)
    if not npc then return false end
    local id = npc:id()

    local m_data = alife_storage_manager and alife_storage_manager.get_state and alife_storage_manager.get_state() or nil
    local complete_looted = (m_data and m_data.Complete_looted) or (grok_loot_claim and grok_loot_claim.looted)
    if complete_looted and complete_looted[id] then
        return true
    end

    local claimed_map = (m_data and m_data.claimed_loot) or (grok_loot_claim and grok_loot_claim.claimed)
    local killer_id = claimed_map and claimed_map[id]
    if killer_id then
        local sender = level.object_by_id(killer_id)
        if sender and sender:alive() and IsStalker(sender) then
            return true
        end
    end
    return false
end

---------------------------------------------------------------------------------------
-- Evaluates HCL_CorpseCheck states (Invalid -> Claimed -> Valid) via 50ms raycast.
-- Arguments: none
-- Returns: (string, game_object|nil) - Evaluated corpse_check_status and hovered_corpse
---------------------------------------------------------------------------------------
local function update_corpse_check()
    if not hcl_mcm or not hcl_mcm.get("hcl_toggle") or not is_hud_ready() then
        corpse_check_status = "INVALID"
        hovered_corpse = nil
        return corpse_check_status, nil
    end

    local max_dist = tonumber(hcl_mcm.get("hcl_max_dist")) or 2
    local ray = get_or_create_ray(max_dist)
    local obj = nil

    if ray then
        local cam_pos = device().cam_pos
        local cam_dir = device().cam_dir
        -- Reset C++ ray_pick range and ignore_object before each query because ray_pick:query()
        -- mutates its internal range in-place to the previous hit distance.
        if ray.ray then
            if ray.ray.set_range then ray.ray:set_range(max_dist) end
            if ray.ray.set_ignore_object and db.actor then ray.ray:set_ignore_object(db.actor) end
        end
        local res = ray:get(cam_pos, cam_dir)
        if res and res.object and res.distance and res.distance <= max_dist then
            if IsStalker(res.object) and not res.object:alive() then
                obj = res.object
            elseif ray.ray and ray.ray.set_ignore_object then
                -- If the ray hit a dropped weapon/item lying on top of a corpse, retry once ignoring it
                ray.ray:set_ignore_object(res.object)
                if ray.ray.set_range then ray.ray:set_range(max_dist) end
                local res2 = ray:get(cam_pos, cam_dir)
                if db.actor then ray.ray:set_ignore_object(db.actor) end
                if res2 and res2.object and res2.distance and res2.distance <= max_dist and IsStalker(res2.object) and not res2.object:alive() then
                    obj = res2.object
                end
            end
        end
    end

    if not obj and level and level.get_target_obj then
        local fallback_obj = level.get_target_obj()
        if fallback_obj and IsStalker(fallback_obj) and not fallback_obj:alive() then
            local t_dist = (level.get_target_dist and level.get_target_dist())
                or (db.actor and fallback_obj:position():distance_to(db.actor:position()))
                or 999
            if t_dist <= max_dist or (db.actor and fallback_obj:position():distance_to(db.actor:position()) <= max_dist) then
                obj = fallback_obj
            end
        end
    end

    -- State 1: Invalid
    if not obj or not IsStalker(obj) or obj:alive() then
        corpse_check_status = "INVALID"
        hovered_corpse = nil
        return corpse_check_status, nil
    end

    hovered_corpse = obj

    -- State 2: Claimed
    if is_corpse_claimed(obj) then
        corpse_check_status = "CLAIMED"
        return corpse_check_status, obj
    end

    -- State 3: Valid
    corpse_check_status = "VALID"
    return corpse_check_status, obj
end

-- [SYSTEM] HCL_CallbackTrigger

local interaction_unlocked = false
local timer_completed = false
local active_corpse_id = nil
local timer_start_tg = 0
local timer_running = false

local hcl_suppress_loot_ui = false
local ui_inventory_patched = false
local orig_ui_inventory_npc_on_use = nil

local corpse_phase1_done = {}
local corpse_phase2_done = {}

---------------------------------------------------------------------------------------
-- Marks a corpse as looted by the player for the [LOOTED] header tag and persists the
-- state in alife_storage_manager so money/stash callbacks never re-fire on save reload.
-- Arguments: corpse_id (number) - Game object ID of the looted corpse
--            corpse_name (string|nil) - Optional engine object name for se_save_var
-- Returns: (nil)
---------------------------------------------------------------------------------------
function mark_corpse_looted(corpse_id, corpse_name)
    if not corpse_id then return end
    looted_corpses[corpse_id] = true
    corpse_phase2_done[corpse_id] = true
    if se_save_var then
        pcall(se_save_var, corpse_id, corpse_name, "hcl_looted", true)
        pcall(se_save_var, corpse_id, corpse_name, "hcl_phase1_only", false)
    end
    if hcl_ui and hcl_ui.mark_dirty then
        hcl_ui.mark_dirty()
    end
end

---------------------------------------------------------------------------------------
-- Checks whether a corpse has already been looted in this session or in a saved game.
-- Recognizes both HCL's 'hcl_looted' flag and corpses searched in existing/pre-HCL saves
-- where 'death_dropped' is already true without an active 'hcl_phase1_only' preview state.
-- Arguments: corpse_id (number) - Game object ID of the corpse
-- Returns: (boolean) - True if the corpse has already been looted
---------------------------------------------------------------------------------------
function is_corpse_looted(corpse_id)
    if not corpse_id then return false end
    if looted_corpses[corpse_id] then return true end
    if se_load_var then
        if se_load_var(corpse_id, nil, "hcl_looted") then
            looted_corpses[corpse_id] = true
            corpse_phase2_done[corpse_id] = true
            return true
        end
        if se_load_var(corpse_id, nil, "death_dropped") and not se_load_var(corpse_id, nil, "hcl_phase1_only") then
            looted_corpses[corpse_id] = true
            corpse_phase2_done[corpse_id] = true
            if se_save_var then
                pcall(se_save_var, corpse_id, nil, "hcl_looted", true)
            end
            return true
        end
    end
    return false
end

---------------------------------------------------------------------------------------
-- Replacement wrapper for UIInventory.npc_on_use that blocks vanilla loot UI during HCL
-- and syncs [LOOTED] + Phase 2 money/faction callbacks when opened via vanilla kUSE.
-- Arguments: self (UIInventory) - Active UIInventory instance
--            obj (game_object) - Used NPC object
--            who (game_object) - Initiating actor object
-- Returns: (any) - Result of original UIInventory.npc_on_use when not suppressed
---------------------------------------------------------------------------------------
local function wrapped_ui_inventory_npc_on_use(self, obj, who)
    if hcl_suppress_loot_ui then
        return
    end
    if obj and IsStalker(obj) and not obj:alive() then
        local id = obj:id()
        local npc_name = obj:name()
        if se_load_var and se_load_var(id, npc_name, "hcl_phase1_only") and not is_corpse_looted(id) then
            if item_money and item_money.actor_on_loot_money then
                pcall(item_money.actor_on_loot_money, obj)
            end
            if character_community then
                SendScriptCallback("actor_on_interaction", "factions", nil, character_community(obj))
            end
        end
        mark_corpse_looted(id, npc_name)
    end
    if orig_ui_inventory_npc_on_use then
        return orig_ui_inventory_npc_on_use(self, obj, who)
    end
end

---------------------------------------------------------------------------------------
-- Installs the scoped UIInventory.npc_on_use suppressor once at game start.
-- Arguments: none
-- Returns: (nil)
---------------------------------------------------------------------------------------
local function install_loot_ui_suppressor()
    if ui_inventory_patched then return end
    if ui_inventory and ui_inventory.UIInventory and ui_inventory.UIInventory.npc_on_use then
        orig_ui_inventory_npc_on_use = ui_inventory.UIInventory.npc_on_use
        ui_inventory.UIInventory.npc_on_use = wrapped_ui_inventory_npc_on_use
        ui_inventory_patched = true
        z_probe(2, "HCL_CallbackTrigger", "Installed scoped UIInventory.npc_on_use suppressor")
    end
end

---------------------------------------------------------------------------------------
-- Executes Phase 1 (PREPARE) item-generation callbacks once for a valid corpse.
-- Sets 'hcl_phase1_only' when triggering death_manager.create_release_item on an unlooted
-- corpse, or marks the corpse [LOOTED] immediately if 'death_dropped' was already set in
-- an existing save prior to HCL Phase 1.
-- Arguments: npc (game_object) - Target dead stalker object
-- Returns: (nil)
---------------------------------------------------------------------------------------
local function run_phase1_item_generation(npc)
    if not npc or not db.actor then return end
    local id = npc:id()
    if corpse_phase1_done[id] then return end
    corpse_phase1_done[id] = true

    local npc_name = npc:name()
    if not se_load_var(id, npc_name, "death_dropped") then
        if se_save_var then
            pcall(se_save_var, id, npc_name, "hcl_phase1_only", true)
        end
        if death_manager and death_manager.create_release_item then
            death_manager.create_release_item(npc)
        end
        if guaranteed_loot and guaranteed_loot.npc_on_use then
            pcall(guaranteed_loot.npc_on_use, npc, db.actor)
        end
    elseif not se_load_var(id, npc_name, "hcl_phase1_only") then
        mark_corpse_looted(id, npc_name)
    end
    z_probe(2, "HCL_CallbackTrigger", "Phase 1 (PREPARE) item generation completed for corpse ID %d", id)
end

---------------------------------------------------------------------------------------
-- Time event callback to trigger FDDA Redone's deferred Haruka Scavenger skill effect.
-- Arguments: none
-- Returns: (boolean) - Always true to terminate the one-shot X-Ray time event
---------------------------------------------------------------------------------------
local function trigger_fdda_scavenger_bonus()
    if liz_fdda_redone_body_search and liz_fdda_redone_body_search.haruka_scavanger_effect then
        liz_fdda_redone_body_search.haruka_scavanger_effect()
    end
    return true
end

---------------------------------------------------------------------------------------
-- Executes Phase 2 (LOOT) non-item callbacks (money, faction, stashes/notes) once and
-- immediately marks the corpse [LOOTED] upon entering LOOT state. Skips all callbacks
-- if the corpse was already looted previously so old saves never spawn duplicate money.
-- Arguments: npc (game_object) - Target dead stalker object
-- Returns: (nil)
---------------------------------------------------------------------------------------
local function run_phase2_non_item_callbacks(npc)
    if not npc or not db.actor then return end
    local id = npc:id()
    if corpse_phase2_done[id] then return end

    run_phase1_item_generation(npc)

    if is_corpse_looted(id) then
        corpse_phase2_done[id] = true
        z_probe(2, "HCL_CallbackTrigger", "Phase 2 (LOOT) skipped for already-looted corpse ID %d", id)
        return
    end

    local npc_name = npc:name()
    mark_corpse_looted(id, npc_name)

    if item_money and item_money.actor_on_loot_money then
        pcall(item_money.actor_on_loot_money, npc)
    end
    if character_community then
        SendScriptCallback("actor_on_interaction", "factions", nil, character_community(npc))
    end

    hcl_suppress_loot_ui = true
    local ok, err = pcall(SendScriptCallback, "npc_on_use", npc, db.actor)
    hcl_suppress_loot_ui = false
    if not ok then
        z_probe(1, "HCL_CallbackTrigger", "Error during Phase 2 npc_on_use on corpse %d: %s", id, tostring(err))
    end

    if liz_fdda_redone_body_search and liz_fdda_redone_body_search.haruka_scavanger_effect then
        CreateTimeEvent("hcl_fdda_scav", "scav_" .. tostring(id), 0.12, trigger_fdda_scavenger_bonus)
    end
    z_probe(2, "HCL_CallbackTrigger", "Phase 2 (LOOT) non-item callbacks released and marked [LOOTED] for corpse ID %d", id)
end

---------------------------------------------------------------------------------------
-- Evaluates HCL_CallbackTrigger top-down state priority (IDLE -> LOOT -> PREVIEW -> PREPARE).
-- Arguments: status (string) - Current corpse_check_status
--            npc (game_object|nil) - Currently hovered corpse object
--            now_tg (number) - Current time_global() timestamp in ms
-- Returns: (string) - Evaluated callback_status ('IDLE'|'PENDING'|'PREVIEW'|'LOOT')
---------------------------------------------------------------------------------------
local function update_callback_trigger(status, npc, now_tg)
    local npc_id = npc and npc:id() or nil

    -- Priority 1: IDLE (not hovering a VALID corpse or target corpse changed)
    if status ~= "VALID" or not npc or (active_corpse_id ~= nil and active_corpse_id ~= npc_id) then
        timer_running = false
        timer_completed = false
        interaction_unlocked = false
        timer_start_tg = 0
        callback_status = "IDLE"
        if status ~= "VALID" or not npc then
            active_corpse_id = nil
            return callback_status
        end
        active_corpse_id = npc_id
    end

    if active_corpse_id == nil then
        active_corpse_id = npc_id
    end

    local delay_ms = (hcl_mcm and tonumber(hcl_mcm.get("hcl_ui_delay"))) or 200
    if timer_running and not timer_completed and (now_tg - timer_start_tg) >= delay_ms then
        timer_completed = true
        timer_running = false
    end

    -- Priority 2: LOOT (interaction unlocked via mouse wheel)
    if interaction_unlocked then
        run_phase2_non_item_callbacks(npc)
        callback_status = "LOOT"
        return callback_status
    end

    -- Priority 3: PREVIEW (delay timer completed)
    if timer_completed then
        callback_status = "PREVIEW"
        return callback_status
    end

    -- Priority 4: PREPARE (delay timer not completed; start once and run item generation)
    if not timer_running then
        timer_running = true
        timer_start_tg = now_tg
        run_phase1_item_generation(npc)
    end
    callback_status = "PENDING"
    return callback_status
end

---------------------------------------------------------------------------------------
-- Unlocks corpse interaction on mouse wheel scroll in PREVIEW and transitions to LOOT.
-- Arguments: none
-- Returns: (boolean) - True if transitioned to LOOT, false otherwise
---------------------------------------------------------------------------------------
function unlock_interaction()
    if corpse_check_status ~= "VALID" or not hovered_corpse then
        return false
    end
    if not timer_completed then
        return false
    end
    if not interaction_unlocked then
        interaction_unlocked = true
        run_phase2_non_item_callbacks(hovered_corpse)
        callback_status = "LOOT"
        z_probe(2, "HCL_CallbackTrigger", "Interaction unlocked via mouse wheel -> LOOT (corpse ID %d)", hovered_corpse:id())
    end
    return true
end

---------------------------------------------------------------------------------------
-- Returns the current public [output] contract of HCL_Main.
-- Arguments: none
-- Returns: (string, string, game_object|nil) - corpse_check_status, callback_status, hovered_corpse
---------------------------------------------------------------------------------------
function get_state()
    return corpse_check_status, callback_status, hovered_corpse
end

---------------------------------------------------------------------------------------
-- Returns the current corpse_check_status ('INVALID' | 'CLAIMED' | 'VALID').
-- Arguments: none
-- Returns: (string) - Current corpse check status
---------------------------------------------------------------------------------------
function get_corpse_check_status()
    return corpse_check_status
end

---------------------------------------------------------------------------------------
-- Returns the current callback_status ('IDLE' | 'PENDING' | 'PREVIEW' | 'LOOT').
-- Arguments: none
-- Returns: (string) - Current callback trigger status
---------------------------------------------------------------------------------------
function get_callback_status()
    return callback_status
end

---------------------------------------------------------------------------------------
-- Returns the currently hovered dead stalker game_object or nil.
-- Arguments: none
-- Returns: (game_object|nil) - Hovered corpse object
---------------------------------------------------------------------------------------
function get_hovered_corpse()
    return hovered_corpse
end

---------------------------------------------------------------------------------------
-- Handles mouse wheel input during PREVIEW state to unlock LOOT mode.
-- Arguments: dir (number) - Mouse wheel direction
--            flags (table) - Callback flags table
-- Returns: (nil)
---------------------------------------------------------------------------------------
local function on_mouse_wheel(dir, flags)
    if corpse_check_status == "VALID" and callback_status == "PREVIEW" and hovered_corpse then
        if unlock_interaction() then
            if hcl_loot and hcl_loot.on_enter_loot_from_preview then
                hcl_loot.on_enter_loot_from_preview()
            end
            if hcl_ui and hcl_ui.refresh_now then
                hcl_ui.refresh_now()
            end
            if flags then
                flags.ret_value = false
            end
        end
    end
end

---------------------------------------------------------------------------------------
-- Throttled 50ms actor update tick orchestrating HCL_CorpseCheck and HCL_CallbackTrigger.
-- Arguments: none
-- Returns: (nil)
---------------------------------------------------------------------------------------
local function actor_on_update()
    local now_tg = time_global()
    if now_tg < next_poll_tg then
        return
    end
    next_poll_tg = now_tg + POLL_INTERVAL_MS

    local status, npc = update_corpse_check()
    hovered_corpse_id = npc and npc:id() or nil
    local cb_status = update_callback_trigger(status, npc, now_tg)

    if hcl_loot and hcl_loot.tick then
        hcl_loot.tick(status, cb_status, npc)
    end
    if hcl_ui and hcl_ui.tick then
        hcl_ui.tick(status, cb_status, npc)
    end
end

---------------------------------------------------------------------------------------
-- Resets cached raycast state when MCM options change.
-- Arguments: none
-- Returns: (nil)
---------------------------------------------------------------------------------------
local function reset_runtime_cache()
    cached_ray = nil
end

---------------------------------------------------------------------------------------
-- Clears session-scoped corpse tracking tables when the actor is destroyed on save load.
-- Arguments: none
-- Returns: (nil)
---------------------------------------------------------------------------------------
local function actor_on_net_destroy()
    cached_ray = nil
    looted_corpses = {}
    corpse_phase1_done = {}
    corpse_phase2_done = {}
    active_corpse_id = nil
    hovered_corpse = nil
    hovered_corpse_id = nil
    corpse_check_status = "INVALID"
    callback_status = "IDLE"
    interaction_unlocked = false
    timer_completed = false
    timer_running = false
end

---------------------------------------------------------------------------------------
-- Registers HCL_Main callbacks and installs the vanilla loot UI suppressor at game start.
-- Arguments: none
-- Returns: (nil)
---------------------------------------------------------------------------------------
function on_game_start()
    install_loot_ui_suppressor()
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("on_mouse_wheel", on_mouse_wheel)
    RegisterScriptCallback("on_option_change", reset_runtime_cache)
    RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
    z_probe(2, "HCL_Main", "HCL_Main event controller initialized")
end
