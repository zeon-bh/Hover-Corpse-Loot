-- [SYSTEM] HCL_Main

corpse_check_status = "INVALID"
callback_status = "IDLE"
hovered_corpse = nil

-- @z [HCL_Main] data:HCL_Main.data
local main_state = {
    corpse_check_status = "INVALID",
    callback_status = "IDLE",
    hovered_corpse = nil,
}

-- @z_func: HCL_Main.z_probe [internal:shared]
local function z_probe(level, func_name, fmt, ...)
    if hcl_debug and hcl_debug.z_probe then
        hcl_debug.z_probe(level, func_name, fmt, ...)
    end
end

-- @z_func: HCL_Main.sync_exports [internal:shared]
local function sync_exports()
    corpse_check_status = main_state.corpse_check_status
    callback_status = main_state.callback_status
    hovered_corpse = main_state.hovered_corpse
end

-- @z_func: HCL_Main.get_corpse_check_status [export:output:get_corpse_check_status]
function get_corpse_check_status()
    return main_state.corpse_check_status
end

-- @z_func: HCL_Main.get_callback_status [export:output:get_callback_status]
function get_callback_status()
    return main_state.callback_status
end

-- @z_func: HCL_Main.get_hovered_corpse [export:output:get_hovered_corpse]
function get_hovered_corpse()
    return main_state.hovered_corpse
end

-- @z_func: HCL_Main.get_state [export:output:get_state]
function get_state()
    return {
        corpse_check_status = main_state.corpse_check_status,
        callback_status = main_state.callback_status,
        hovered_corpse = main_state.hovered_corpse,
    }
end

-- @z_func: HCL_Main.is_corpse_looted [export:output:is_corpse_looted] | bind:hcl_two_phase_corpse_callbacks
function is_corpse_looted(corpse)
    if not corpse then
        return false
    end
    local id = corpse:id()
    local name = corpse:name()
    if se_load_var(id, name, "hcl_looted") then
        return true
    end
    local death_dropped = se_load_var(id, name, "death_dropped")
    local phase1_only = se_load_var(id, name, "hcl_phase1_only")
    if death_dropped and not phase1_only then
        return true
    end
    return false
end

-- [SYSTEM] HCL_CorpseCheck

-- @z [HCL_CorpseCheck] data:RayCast Parameters
local raycast_params = {
    polling_rate = 50,
    next_poll_tg = 0,
    cached_ray = nil,
}

-- @z_func: HCL_CorpseCheck.is_dead_human_stalker [internal:shared] | bind:hcl_corpse_raycast
local function is_dead_human_stalker(obj)
    if obj and IsStalker(obj) and not obj:alive() then
        return true
    end
    return false
end

-- @z_func: HCL_CorpseCheck.is_corpse_claimed [internal:Claimed] | bind:hcl_loot_claim_eval
local function is_corpse_claimed(corpse)
    if not corpse or not alife_storage_manager or not alife_storage_manager.get_state then
        return false
    end
    local m_data = alife_storage_manager.get_state()
    if not m_data then
        return false
    end
    local id = corpse:id()
    if m_data.Complete_looted and m_data.Complete_looted[id] then
        return true
    end
    if m_data.claimed_loot and m_data.claimed_loot[id] then
        local claimer_id = m_data.claimed_loot[id]
        if type(claimer_id) == "number" then
            local sender = level.object_by_id(claimer_id)
            if sender and sender:alive() and IsStalker(sender) then
                return true
            end
        end
    end
    return false
end

-- @z_func: HCL_CorpseCheck.probe_corpse_raycast [export:rule:Active Polling Guard] | bind:hcl_corpse_raycast | states:Invalid,Valid
function probe_corpse_raycast(max_dist)
    local target = nil
    if demonized_geometry_ray and demonized_geometry_ray.geometry_ray then
        local ray = raycast_params.cached_ray
        if not ray then
            ray = demonized_geometry_ray.geometry_ray({
                ray_range = max_dist,
                contact_range = max_dist,
                flags = 3,
                ignore_object = db.actor,
            })
            raycast_params.cached_ray = ray
        end
        -- C++ ray_pick:query() mutates internal range in-place on hit; reset before every query
        ray.ray_range = max_dist
        ray.contact_range = max_dist
        if ray.ray then
            ray.ray:set_range(max_dist)
            ray.ray:set_ignore_object(db.actor)
        end
        local cam = device()
        local res = ray:get(cam.cam_pos, cam.cam_dir)
        local hit_obj = res and (res.object or (res.result and res.result.object))
        if is_dead_human_stalker(hit_obj) then
            target = hit_obj
        elseif hit_obj then
            -- Retry once ignoring dynamic clutter (e.g. dropped weapon lying on corpse)
            ray.ray_range = max_dist
            ray.contact_range = max_dist
            if ray.ray then
                ray.ray:set_range(max_dist)
                ray.ray:set_ignore_object(hit_obj)
            end
            local retry_res = ray:get(cam.cam_pos, cam.cam_dir)
            local retry_obj = retry_res and (retry_res.object or (retry_res.result and retry_res.result.object))
            if is_dead_human_stalker(retry_obj) then
                target = retry_obj
            end
        end
    end
    if not target then
        local fallback_obj = level.get_target_obj()
        if fallback_obj and level.get_target_dist() <= max_dist and is_dead_human_stalker(fallback_obj) then
            target = fallback_obj
        end
    end
    return target
end

-- @z_func: HCL_CorpseCheck.enter_corpse_invalid [export:state:Invalid] | bind:hcl_corpse_raycast
function enter_corpse_invalid()
    main_state.corpse_check_status = "INVALID"
    main_state.hovered_corpse = nil
    sync_exports()
end

-- @z_func: HCL_CorpseCheck.enter_corpse_claimed [export:state:Claimed] | bind:hcl_loot_claim_eval
function enter_corpse_claimed(corpse)
    main_state.hovered_corpse = corpse
    main_state.corpse_check_status = "CLAIMED"
    sync_exports()
end

-- @z_func: HCL_CorpseCheck.enter_corpse_valid [export:state:Valid] | bind:hcl_corpse_raycast
function enter_corpse_valid(corpse)
    main_state.hovered_corpse = corpse
    main_state.corpse_check_status = "VALID"
    sync_exports()
end

-- [SYSTEM] HCL_CallbackTrigger

-- @z [HCL_CallbackTrigger] data:Callback Latches
local callback_latches = {
    interaction_unlocked = false,
    timer_completed = false,
    active_corpse_id = nil,
    timer_running = false,
    loot_executed = false,
    suppress_vanilla_loot = false,
    inv_hook_installed = false,
}

-- @z_func: HCL_CallbackTrigger.run_deferred_scavenger [internal:LOOT] | bind:hcl_two_phase_corpse_callbacks
local function run_deferred_scavenger()
    if liz_fdda_redone_body_search and liz_fdda_redone_body_search.haruka_scavanger_effect then
        liz_fdda_redone_body_search.haruka_scavanger_effect()
    end
    return true
end

-- @z_func: HCL_CallbackTrigger.install_vanilla_inventory_guard [export:rule:Vanilla Inventory Suppression] | bind:hcl_two_phase_corpse_callbacks
function install_vanilla_inventory_guard()
    if callback_latches.inv_hook_installed then
        return
    end
    if ui_inventory and ui_inventory.UIInventory and ui_inventory.UIInventory.npc_on_use then
        local orig_npc_on_use = ui_inventory.UIInventory.npc_on_use
        ui_inventory.UIInventory.npc_on_use = function(self_inv, obj, who)
            if callback_latches.suppress_vanilla_loot then
                return
            end
            return orig_npc_on_use(self_inv, obj, who)
        end
        callback_latches.inv_hook_installed = true
    end
end

-- @z_func: HCL_CallbackTrigger.reset_callback_trigger_idle [internal:IDLE]
local function reset_callback_trigger_idle()
    if callback_latches.timer_running then
        RemoveTimeEvent("hcl_ui_delay", "delay")
        callback_latches.timer_running = false
    end
    callback_latches.interaction_unlocked = false
    callback_latches.timer_completed = false
    callback_latches.active_corpse_id = nil
    callback_latches.loot_executed = false
    main_state.callback_status = "IDLE"
    sync_exports()
end

-- @z_func: HCL_CallbackTrigger.enter_callback_idle [export:state:IDLE]
function enter_callback_idle()
    reset_callback_trigger_idle()
end

-- @z_func: HCL_CallbackTrigger.enter_callback_loot [export:state:LOOT] | bind:hcl_two_phase_corpse_callbacks
function enter_callback_loot(corpse)
    if not corpse then
        return
    end
    main_state.callback_status = "LOOT"
    sync_exports()
    if callback_latches.loot_executed then
        return
    end
    callback_latches.loot_executed = true

    local id = corpse:id()
    local name = corpse:name()
    local already_looted = is_corpse_looted(corpse)
    if not already_looted then
        se_save_var(id, name, "hcl_looted", true)
        se_save_var(id, name, "hcl_phase1_only", false)
        z_probe(2, "hcl_main.enter_callback_loot", "Phase 2 LOOT unlocked for corpse id=%d (%s)", id, name)

        if item_money and item_money.actor_on_loot_money then
            item_money.actor_on_loot_money(corpse)
        end

        local comm = (character_community and character_community(corpse)) or (corpse.character_community and corpse:character_community())
        if comm then
            SendScriptCallback("actor_on_interaction", "factions", nil, comm)
        end

        install_vanilla_inventory_guard()
        callback_latches.suppress_vanilla_loot = true
        SendScriptCallback("npc_on_use", corpse, db.actor)
        callback_latches.suppress_vanilla_loot = false

        CreateTimeEvent("hcl_phase2", "haruka_scav_" .. tostring(id), 0.05, run_deferred_scavenger)
    else
        z_probe(2, "hcl_main.enter_callback_loot", "Corpse id=%d already looted; skipped Phase 2 callbacks", id)
    end
end

-- @z_func: HCL_CallbackTrigger.enter_callback_preview [export:state:PREVIEW]
function enter_callback_preview()
    if main_state.callback_status ~= "PREVIEW" then
        main_state.callback_status = "PREVIEW"
        sync_exports()
        z_probe(2, "hcl_main.enter_callback_preview", "Entered PREVIEW for corpse id=%s", callback_latches.active_corpse_id)
    end
end

-- @z_func: HCL_CallbackTrigger.on_ui_delay_complete [internal:PREPARE]
local function on_ui_delay_complete()
    callback_latches.timer_running = false
    callback_latches.timer_completed = true
    if main_state.corpse_check_status == "VALID" and main_state.hovered_corpse then
        if callback_latches.interaction_unlocked then
            enter_callback_loot(main_state.hovered_corpse)
        else
            enter_callback_preview()
        end
    end
    return true
end

-- @z_func: HCL_CallbackTrigger.enter_callback_prepare [export:state:PREPARE] | bind:hcl_two_phase_corpse_callbacks
function enter_callback_prepare(corpse)
    if not corpse then
        return
    end
    local id = corpse:id()
    if callback_latches.active_corpse_id == id and callback_latches.timer_running then
        return
    end
    callback_latches.active_corpse_id = id
    callback_latches.timer_completed = false
    callback_latches.timer_running = true
    callback_latches.loot_executed = false
    main_state.callback_status = "PENDING"
    sync_exports()

    local name = corpse:name()
    local death_dropped = se_load_var(id, name, "death_dropped")
    if not death_dropped then
        se_save_var(id, name, "hcl_phase1_only", true)
        if death_manager and death_manager.create_release_item then
            death_manager.create_release_item(corpse)
        end
        if guaranteed_loot and guaranteed_loot.npc_on_use then
            guaranteed_loot.npc_on_use(corpse, db.actor)
        end
        z_probe(2, "hcl_main.enter_callback_prepare", "Phase 1 PREPARE generated items for corpse id=%d", id)
    end

    local delay_ms = tonumber(hcl_mcm.get_config("hcl_ui_delay")) or 200
    local delay_sec = math.max(0.05, delay_ms / 1000.0)
    CreateTimeEvent("hcl_ui_delay", "delay", delay_sec, on_ui_delay_complete)
end

-- @z_func: HCL_CallbackTrigger.evaluate_callback_state [internal:shared] | states:IDLE,LOOT,PREVIEW,PREPARE
local function evaluate_callback_state()
    local target = main_state.hovered_corpse
    local target_id = target and target:id() or nil
    if main_state.corpse_check_status ~= "VALID" or not target_id then
        if main_state.callback_status ~= "IDLE" or callback_latches.active_corpse_id ~= nil then
            enter_callback_idle()
        end
        return
    end
    if callback_latches.active_corpse_id ~= nil and callback_latches.active_corpse_id ~= target_id then
        enter_callback_idle()
    end
    if callback_latches.interaction_unlocked then
        enter_callback_loot(target)
    elseif callback_latches.timer_completed then
        enter_callback_preview()
    else
        enter_callback_prepare(target)
    end
end

-- @z_func: HCL_Main.actor_on_update [export:callback:actor_on_update] | bind:hcl_corpse_raycast | states:Invalid,Claimed,Valid,IDLE,LOOT,PREVIEW,PREPARE
function actor_on_update()
    local tg = time_global()
    if tg < raycast_params.next_poll_tg then
        return
    end
    raycast_params.next_poll_tg = tg + raycast_params.polling_rate

    if not db.actor or not db.actor:alive() or not hcl_mcm.get_config("hcl_toggle") then
        enter_corpse_invalid()
        evaluate_callback_state()
        return
    end
    if not main_hud_shown() or actor_menu.get_last_mode() ~= 0 then
        enter_corpse_invalid()
        evaluate_callback_state()
        return
    end

    local max_dist = tonumber(hcl_mcm.get_config("hcl_max_dist")) or 2.0
    local corpse = probe_corpse_raycast(max_dist)
    if not corpse then
        enter_corpse_invalid()
    elseif is_corpse_claimed(corpse) then
        enter_corpse_claimed(corpse)
    else
        enter_corpse_valid(corpse)
    end
    evaluate_callback_state()
end

-- @z_func: HCL_CallbackTrigger.on_mouse_wheel [export:callback:on_mouse_wheel] | states:PREVIEW,LOOT
function on_mouse_wheel(dir, flags)
    if main_state.corpse_check_status == "VALID" and main_state.callback_status == "PREVIEW" and main_state.hovered_corpse then
        callback_latches.interaction_unlocked = true
        enter_callback_loot(main_state.hovered_corpse)
        if flags then
            flags.ret_value = false
        end
    end
end

-- @z_func: HCL_Main.on_game_start [export:callback:on_game_start]
function on_game_start()
    install_vanilla_inventory_guard()
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("on_mouse_wheel", on_mouse_wheel)
    z_probe(2, "hcl_main.on_game_start", "Registered HCL_Main callbacks")
end
