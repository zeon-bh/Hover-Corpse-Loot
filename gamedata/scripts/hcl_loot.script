-- [SYSTEM] HCL_Loot

-- @z [HCL_Loot] helper:z_probe
-- @z_func: HCL_Loot.z_probe [internal]
local function z_probe(func_name, fmt, ...)
    if hcl_debug and hcl_debug.z_probe then
        hcl_debug.z_probe(func_name, fmt, ...)
    end
end

-- @z [HCL_Loot] data:Hover UI parameters
local loot_state = {
    cursor_idx = nil,
    cursor_object = nil,
    alt_modifier = false,
    special_func = nil,
    grid_rows = {},
    lmb_held = false,
    rmb_held = false,
    lmb_press_tg = 0,
    rmb_press_tg = 0,
    lmb_swept_during_hold = false,
    rmb_disassembly_consumed = false,
    last_rmb_autoloot_tg = 0,
    last_disassembly_tg = 0,
    was_in_loot = false,
}

-- [SYSTEM] HCL_Loot_Scroll

-- @z [HCL_Loot_Scroll] data:Scroll Wheel Parameters
local scroll_params = {
    s_direction = "DOWN",
    last_scroll_tg = 0,
    velocity_steps = 1,
}

-- [SYSTEM] HCL_Loot_MBC

-- @z [HCL_Loot_MBC] data:Mouse Click Parameters
local mbc_params = {
    s_acceleration = 1.0,
    s_brake_factor = 1.0,
    row_brake_latched = false,
}

-- @z [HCL_Loot] helper:is_item_revealed_for_loot
-- @z_func: HCL_Loot.is_item_revealed_for_loot [internal]
local function is_item_revealed_for_loot(obj, npc)
    if not obj then
        return false
    end
    if hcl_ui and type(hcl_ui.is_item_lootable) == "function" then
        return hcl_ui.is_item_lootable(obj, npc)
    end
    if _G.zzzz_loot_searching and type(_G.zzzz_loot_searching.is_item_hidden) == "function" and npc then
        if _G.zzzz_loot_searching.is_item_hidden(npc:id(), obj:id()) then
            return false
        end
    end
    return true
end

-- @z [HCL_Loot] helper:sync_cursor_with_grid | states:IDLE,LOOT
-- @z_func: HCL_Loot.sync_cursor_with_grid [export:state]
function sync_cursor_with_grid(rows)
    if type(rows) == "table" then
        loot_state.grid_rows = rows
    end
    local cb_status = hcl_main and hcl_main.get_callback_status() or "IDLE"
    if cb_status ~= "LOOT" then
        loot_state.cursor_idx = nil
        loot_state.cursor_object = nil
        return nil, nil
    end
    local total_rows = #loot_state.grid_rows
    if total_rows == 0 then
        loot_state.cursor_idx = nil
        loot_state.cursor_object = nil
        return nil, nil
    end
    if not loot_state.cursor_idx then
        loot_state.cursor_idx = { x = 1, y = 1 }
    end
    if loot_state.cursor_idx.y < 1 then
        loot_state.cursor_idx.y = 1
    elseif loot_state.cursor_idx.y > total_rows then
        loot_state.cursor_idx.y = total_rows
    end
    local row = loot_state.grid_rows[loot_state.cursor_idx.y] or {}
    local row_len = #row
    if row_len == 0 then
        loot_state.cursor_idx = nil
        loot_state.cursor_object = nil
        return nil, nil
    end
    if loot_state.cursor_idx.x < 1 then
        loot_state.cursor_idx.x = 1
    elseif loot_state.cursor_idx.x > row_len then
        loot_state.cursor_idx.x = row_len
    end
    local cell = row[loot_state.cursor_idx.x]
    loot_state.cursor_object = cell and cell.obj or nil
    return loot_state.cursor_idx, loot_state.cursor_object
end

-- @z [HCL_Loot] helper:transfer_cell_stack
-- @z_func: HCL_Loot.transfer_cell_stack [export:rule]
function transfer_cell_stack(cell, npc)
    if not cell or not npc or not db.actor then
        return false
    end
    local primary_obj = cell.obj
    if not primary_obj or not is_item_revealed_for_loot(primary_obj, npc) then
        return false
    end
    local ids = cell.child_ids
    if type(ids) == "table" and #ids > 0 then
        for i = 1, #ids do
            local obj = level.object_by_id(ids[i])
            if obj and is_item_revealed_for_loot(obj, npc) then
                npc:transfer_item(obj, db.actor)
            end
        end
    else
        npc:transfer_item(primary_obj, db.actor)
    end
    if hcl_ui and type(hcl_ui.request_grid_refresh) == "function" then
        hcl_ui.request_grid_refresh()
    end
    return true
end

-- @z [HCL_Loot_Scroll] rule:Scroll Policy
-- @z_func: HCL_Loot_Scroll.step_cursor [export:rule]
function step_cursor(direction, alt_mod, step_count)
    local total_rows = #loot_state.grid_rows
    if total_rows == 0 then
        loot_state.cursor_idx = nil
        loot_state.cursor_object = nil
        return
    end
    if not loot_state.cursor_idx then
        loot_state.cursor_idx = { x = 1, y = 1 }
    end
    scroll_params.s_direction = direction
    local delta = (direction == "DOWN") and 1 or -1
    local steps = math.max(1, tonumber(step_count) or 1)

    for _ = 1, steps do
        local y = loot_state.cursor_idx.y
        local x = loot_state.cursor_idx.x
        local row = loot_state.grid_rows[y] or {}
        local row_len = #row
        if alt_mod then
            local ny = y + delta
            if ny < 1 then
                ny = 1
            elseif ny > total_rows then
                ny = total_rows
            end
            loot_state.cursor_idx.y = ny
            local new_row = loot_state.grid_rows[ny] or {}
            if loot_state.cursor_idx.x > #new_row then
                loot_state.cursor_idx.x = math.max(1, #new_row)
            end
        else
            local nx = x + delta
            if nx >= 1 and nx <= row_len then
                loot_state.cursor_idx.x = nx
            elseif nx > row_len and y < total_rows then
                loot_state.cursor_idx.y = y + 1
                loot_state.cursor_idx.x = 1
                mbc_params.row_brake_latched = true
                mbc_params.row_brake_tg = time_global()
            elseif nx < 1 and y > 1 then
                loot_state.cursor_idx.y = y - 1
                local prev_row = loot_state.grid_rows[y - 1] or {}
                loot_state.cursor_idx.x = math.max(1, #prev_row)
                mbc_params.row_brake_latched = true
                mbc_params.row_brake_tg = time_global()
            end
        end
    end
    sync_cursor_with_grid()
end

-- [SYSTEM] HCL_Loot_Special_Function

-- @z [HCL_Loot_Special_Function] helper:is_valid_loaded_magazine | bind:hcl_mag_redux_unload | states:IDLE,UNLOAD_MAGAZINE
-- @z_func: HCL_Loot_Special_Function.is_valid_loaded_magazine [internal]
local function is_valid_loaded_magazine(obj)
    if not obj or not _G.magazine_binder or not _G.magazines then
        return false
    end
    -- Verify via magazine_binder.is_magazine / get_data / get_mag_loaded
    if type(_G.magazine_binder.is_magazine) ~= "function" or not _G.magazine_binder.is_magazine(obj) then
        return false
    end
    if type(_G.magazine_binder.get_data) == "function" then
        local mdata = _G.magazine_binder.get_data(obj:id())
        if mdata and type(mdata.loaded) == "table" and #mdata.loaded > 0 then
            return true
        end
    end
    if type(_G.magazine_binder.get_mag_loaded) == "function" then
        local cnt = _G.magazine_binder.get_mag_loaded(obj)
        if type(cnt) == "number" and cnt > 0 then
            return true
        end
    end
    return false
end

-- @z [HCL_Loot_Special_Function] state:DISASSEMBLY | bind:hcl_disassembly_dispatch | states:DISASSEMBLY
-- @z_func: HCL_Loot_Special_Function.execute_disassembly [internal]
local function execute_disassembly(obj, npc)
    local tg = time_global()
    if tg - loot_state.last_disassembly_tg < 500 then
        loot_state.special_func = nil
        return
    end
    if not obj or not npc or not is_item_revealed_for_loot(obj, npc) then
        loot_state.special_func = nil
        return
    end
    if not _G.item_parts or type(_G.item_parts.func_disassembly) ~= "function" then
        loot_state.special_func = nil
        return
    end
    loot_state.last_disassembly_tg = tg
    -- Compat with item_parts (disassembly_item, timer_disassembly_weapon, disassembly_weapon,
    -- timer_disassembly_outfit, disassembly_outfit) and zzzz_arti_jamming_repairs (custom_disassembly_weapon)
    -- and zzz_dit_repair_notifications.
    local old_d_flag = _G.item_parts.d_flag
    local old_dit_d = _G.zzz_dit and _G.zzz_dit.d_flag or nil
    local old_dit_b = _G.zzz_dit and _G.zzz_dit.b_flag or nil
    local orig_cte = _G.CreateTimeEvent
    _G.item_parts.d_flag = true
    if _G.zzz_dit then
        _G.zzz_dit.d_flag = true
        _G.zzz_dit.b_flag = true
    end
    _G.CreateTimeEvent = function(ev_id, act_id, timer, f, ...)
        if tostring(ev_id):find("delay_disassembly") and type(f) == "function" then
            local wrapped = function(...)
                local res = f(...)
                if hcl_ui and type(hcl_ui.request_grid_refresh) == "function" then
                    hcl_ui.request_grid_refresh()
                end
                orig_cte("hcl_disasm_refresh_ev", "hcl_disasm_refresh_act", 0.20, function()
                    if hcl_ui and type(hcl_ui.request_grid_refresh) == "function" then
                        hcl_ui.request_grid_refresh()
                    end
                    return true
                end)
                return res
            end
            return orig_cte(ev_id, act_id, timer, wrapped, ...)
        end
        return orig_cte(ev_id, act_id, timer, f, ...)
    end
    pcall(_G.item_parts.func_disassembly, obj, nil)
    _G.CreateTimeEvent = orig_cte
    _G.item_parts.d_flag = old_d_flag
    if _G.zzz_dit then
        _G.zzz_dit.d_flag = old_dit_d
        _G.zzz_dit.b_flag = old_dit_b
    end
    loot_state.special_func = nil
end

-- @z [HCL_Loot_Special_Function] state:FIELD_STRIP | bind:hcl_field_strip_weapon | states:FIELD_STRIP
-- @z_func: HCL_Loot_Special_Function.execute_field_strip [internal]
local function execute_field_strip(wpn, npc)
    if not wpn or not npc or not is_item_revealed_for_loot(wpn, npc) then
        loot_state.special_func = nil
        return
    end
    if not IsWeapon(wpn) or IsMelee(wpn) then
        loot_state.special_func = nil
        return
    end
    local stripped_lines = {}
    local sec = wpn:section()
    local parent_sec = ini_sys:r_string_ex(sec, "parent_section") or sec

    -- 1. Unload magazine / ammo
    if _G.mag_support and type(_G.mag_support.eject_mag) == "function" and _G.mag_support.using_mags and _G.mag_support.using_mags() then
        pcall(_G.mag_support.eject_mag, wpn)
    elseif type(wpn.force_unload_magazine) == "function" then
        wpn:force_unload_magazine(true)
    end

    -- 2. Detach native attachments (sl, gl, sc) without calling item_weapon.detach_scope
    local addon_types = {
        { flag = 1, param = "scopes_sect", key = "scope_status" },
        { flag = 2, param = "grenade_launcher_sect", key = "grenade_launcher_status" },
        { flag = 4, param = "silencer_sect", key = "silencer_status" },
    }
    for i = 1, #addon_types do
        local info = addon_types[i]
        local status = ini_sys:r_float_ex(sec, info.key) or 0
        if status == 2 and utils_item and type(utils_item.addon_attached) == "function" and utils_item.addon_attached(wpn, nil, info.flag) then
            local addon_sec = ini_sys:r_string_ex(sec, info.param)
            if addon_sec and type(wpn.weapon_addon_detach) == "function" then
                wpn:weapon_addon_detach(addon_sec, false)
                alife_create_item(addon_sec, db.actor)
                local inv_name = ui_item and ui_item.get_sec_name(addon_sec) or addon_sec
                stripped_lines[#stripped_lines + 1] = "• " .. tostring(inv_name)
            end
        end
    end

    -- Zero server addon_flags via utils_stpk so scope clone never duplicates detached addons
    local se_wpn = alife_object(wpn:id())
    if se_wpn and utils_stpk and type(utils_stpk.get_weapon_data) == "function" then
        local stpk_data = utils_stpk.get_weapon_data(se_wpn)
        if stpk_data then
            stpk_data.addon_flags = 0
            utils_stpk.set_weapon_data(stpk_data, se_wpn)
        end
    end

    -- 3. Strip WPO parts >= hcl_wpn_prt_min_cond (has_parts_fieldstrip / remove_name / init_fieldstrip_menu / act_fieldstrip / remove_part / patched_init)
    local min_cond = (hcl_mcm and tonumber(hcl_mcm.get_config("hcl_wpn_prt_min_cond"))) or 60
    local parts = _G.item_parts and type(_G.item_parts.get_parts_con) == "function" and _G.item_parts.get_parts_con(wpn, nil, true) or nil
    if parts and _G.zzzz_arti_jamming_repairs and type(_G.zzzz_arti_jamming_repairs.remove_part) == "function" then
        for k, v in pairs(parts) do
            if k ~= parent_sec and k ~= sec and type(v) == "number" and v >= min_cond and not tostring(k):find("barrel") then
                _G.zzzz_arti_jamming_repairs.remove_part(k, parts)
                local p_name = ui_item and ui_item.get_sec_name(k) or tostring(k)
                local c_col = (utils_xml and type(utils_xml.get_color_con) == "function") and utils_xml.get_color_con(v) or ""
                local c_def = (utils_xml and type(utils_xml.get_color) == "function") and utils_xml.get_color("pda_white") or "%c[default]"
                stripped_lines[#stripped_lines + 1] = string.format("• %s (%s%d%%%s)", tostring(p_name), tostring(c_col), math.floor(v), tostring(c_def))
            end
        end
        if type(_G.item_parts.set_parts_con) == "function" then
            _G.item_parts.set_parts_con(wpn:id(), parts)
        end
    end

    -- 4. Detach integrated parent_section scope via single alife_clone_weapon after set_parts_con
    if parent_sec ~= sec then
        local scope_sec = string.sub(sec, string.len(parent_sec) + 2)
        if scope_sec and scope_sec ~= "" and ini_sys:section_exist(scope_sec) then
            alife_create_item(scope_sec, db.actor)
            local s_name = ui_item and ui_item.get_sec_name(scope_sec) or scope_sec
            stripped_lines[#stripped_lines + 1] = "• " .. tostring(s_name)
            if se_wpn and type(alife_clone_weapon) == "function" then
                local parts_copy = parts and dup_table(parts) or nil
                local se_new = alife_clone_weapon(se_wpn, parent_sec)
                if se_new and parts_copy and _G.item_parts and type(_G.item_parts.set_parts_con) == "function" then
                    parts_copy[sec] = nil
                    _G.item_parts.set_parts_con(se_new.id, parts_copy)
                end
            end
        end
    end

    -- 5. Send PDA notification tip
    if #stripped_lines > 0 and db.actor and news_manager and type(news_manager.send_tip) == "function" then
        local w_name = ui_item and ui_item.get_sec_name(parent_sec) or sec
        local msg = tostring(w_name) .. " - Field Stripped:\\n" .. table.concat(stripped_lines, "\\n")
        news_manager.send_tip(db.actor, msg, nil, "swiss_knife", 6000)
    end
    if hcl_ui and type(hcl_ui.request_grid_refresh) == "function" then
        hcl_ui.request_grid_refresh()
    end
    loot_state.special_func = nil
end

-- @z [HCL_Loot_Special_Function] state:UNLOAD_MAGAZINE | bind:hcl_mag_redux_unload | states:UNLOAD_MAGAZINE
-- @z_func: HCL_Loot_Special_Function.execute_unload_magazine [internal]
local function execute_unload_magazine(mag_obj, npc)
    if not mag_obj or not npc or not is_item_revealed_for_loot(mag_obj, npc) then
        loot_state.special_func = nil
        return
    end
    if not is_valid_loaded_magazine(mag_obj) then
        loot_state.special_func = nil
        return
    end
    -- Redirect create_ammo parent to db.actor:id() during fast_unload_magazine (unload_behavior == 1)
    -- Compat with magazines (action_in_progress, action_start_reload, action_start_magload,
    -- do_interrupt_reload, do_interrupt_magload, do_interrupt, create_time_event, get_mag_time,
    -- on_option_change, timed_refresh, inventory_refresh, unload_magazine, fast_unload_magazine,
    -- on_key_press, unload_ammo, func_unload_ammo) and magazines_mcm (get_config, on_mcm_load).
    local orig_create_ammo = _G.alife_create_item
    _G.alife_create_item = function(section, obj_or_tbl, t)
        if obj_or_tbl and type(obj_or_tbl) == "userdata" and type(obj_or_tbl.id) == "function" and npc and obj_or_tbl:id() == npc:id() then
            return orig_create_ammo(section, db.actor, t)
        end
        return orig_create_ammo(section, obj_or_tbl, t)
    end
    if _G.magazines and type(_G.magazines.func_unload_ammo) == "function" then
        pcall(_G.magazines.func_unload_ammo, mag_obj)
    elseif _G.magazines and type(_G.magazines.unload_magazine) == "function" then
        pcall(_G.magazines.unload_magazine, mag_obj)
    end
    _G.alife_create_item = orig_create_ammo
    if hcl_ui and type(hcl_ui.request_grid_refresh) == "function" then
        hcl_ui.request_grid_refresh()
    end
    loot_state.special_func = nil
end

-- @z [HCL_Loot_Special_Function] state:IDLE | states:IDLE,DISASSEMBLY,FIELD_STRIP,UNLOAD_MAGAZINE
-- @z_func: HCL_Loot_Special_Function.evaluate_special_function [export:state]
function evaluate_special_function()
    local sf = loot_state.special_func
    local obj = loot_state.cursor_object
    local npc = hcl_main and hcl_main.get_hovered_corpse() or nil

    -- Priority 1: IDLE guard
    if sf == nil or obj == nil or npc == nil then
        loot_state.special_func = nil
        return "IDLE"
    end
    if sf == "field_strip" and (not IsWeapon(obj) or IsMelee(obj)) then
        loot_state.special_func = nil
        return "IDLE"
    end
    if sf == "unload_magazine" and not is_valid_loaded_magazine(obj) then
        loot_state.special_func = nil
        return "IDLE"
    end

    -- Priority 2: DISASSEMBLY
    if sf == "disassembly" then
        execute_disassembly(obj, npc)
        return "DISASSEMBLY"
    end

    -- Priority 3: FIELD_STRIP
    if sf == "field_strip" then
        execute_field_strip(obj, npc)
        return "FIELD_STRIP"
    end

    -- Priority 4: UNLOAD_MAGAZINE
    if sf == "unload_magazine" then
        execute_unload_magazine(obj, npc)
        return "UNLOAD_MAGAZINE"
    end

    loot_state.special_func = nil
    return "IDLE"
end

-- @z [HCL_Loot_MBC] helper:loot_all_corpse_items | bind:hcl_autolooter_rmb
-- @z_func: HCL_Loot_MBC.loot_all_corpse_items [internal]
local function loot_all_corpse_items(npc)
    if not npc or not db.actor then
        return
    end
    local to_transfer = {}
    npc:iterate_inventory(function(owner, item)
        if item and is_item_revealed_for_loot(item, npc) then
            local sec = item:section()
            local gw = SYS_GetParam(2, sec, "inv_grid_width") or 0
            local is_anim = IsItem and type(IsItem) == "function" and IsItem("anim", sec) or false
            if sec ~= "bolt" and sec ~= "dev_bolt" and sec ~= "device_pda" and not is_anim and gw > 0 and not ini_sys:r_bool_ex(sec, "quest_item", false) then
                to_transfer[#to_transfer + 1] = item
            end
        end
    end, npc)
    for i = 1, #to_transfer do
        npc:transfer_item(to_transfer[i], db.actor)
    end
    if hcl_ui and type(hcl_ui.request_grid_refresh) == "function" then
        hcl_ui.request_grid_refresh()
    end
end

-- @z [HCL_Loot_MBC] rule:Mouse RMB | bind:hcl_autolooter_rmb
-- @z_func: HCL_Loot_MBC.execute_rmb_loot_or_autoloot [export:rule]
function execute_rmb_loot_or_autoloot(alt_mod)
    if not loot_state.cursor_idx then
        return
    end
    local npc = hcl_main and hcl_main.get_hovered_corpse() or nil
    if not npc then
        return
    end
    if alt_mod then
        if loot_state.cursor_object and not loot_state.rmb_disassembly_consumed then
            loot_state.rmb_disassembly_consumed = true
            loot_state.special_func = "disassembly"
            evaluate_special_function()
        end
        return
    end
    local tg = time_global()
    if tg - loot_state.last_rmb_autoloot_tg < 500 then
        return
    end
    loot_state.last_rmb_autoloot_tg = tg

    -- Check iTheon's z_auto_looter (load_defaults, load_settings, is_right_key, is_placable_stash,
    -- get_actor, auto_looter, continue_looter, collect_items, handle_unload, handle_disassemble,
    -- get_disassembly_tool, cond_ammo_disassemble, cond_armor_disassemble, cond_weapon_disassemble,
    -- cond_misc_disassemble, handle_strip, handle_queue, recursive_time_event, handle_loot,
    -- cond_loot_armor_part, cond_loot_weapon_part, cond_misc_loot, handle_delete, load_state,
    -- is_misc_item_defined_in_disassemble_config) and auto_looter_mcm (concat, on_mcm_load).
    local autoloot_enabled = true
    if ui_mcm and type(ui_mcm.get) == "function" then
        local mcm_en = ui_mcm.get("auto_looter/enable_auto_looter")
        if mcm_en ~= nil then
            autoloot_enabled = (mcm_en == true)
        end
    end
    if _G.z_auto_looter and type(_G.z_auto_looter.auto_looter) == "function" and autoloot_enabled then
        if ui_inventory and not ui_inventory.GUI and type(ui_inventory.start) == "function" then
            pcall(function()
                if ui_inventory.UIInventory then
                    ui_inventory.GUI = ui_inventory.UIInventory()
                end
            end)
        end
        local orig_get_actor = _G.z_auto_looter.get_actor
        local orig_handle_disasm = _G.z_auto_looter.handle_disassemble
        _G.z_auto_looter.get_actor = function()
            return npc
        end
        if type(orig_handle_disasm) == "function" then
            _G.z_auto_looter.handle_disassemble = function(...)
                if _G.item_parts then
                    _G.item_parts.d_flag = true
                end
                if _G.zzz_dit then
                    _G.zzz_dit.d_flag = true
                end
                return orig_handle_disasm(...)
            end
        end
        pcall(_G.z_auto_looter.auto_looter, nil, npc)
        _G.z_auto_looter.get_actor = orig_get_actor
        _G.z_auto_looter.handle_disassemble = orig_handle_disasm
        if hcl_ui and type(hcl_ui.request_grid_refresh) == "function" then
            hcl_ui.request_grid_refresh()
        end
        return
    end
    loot_all_corpse_items(npc)
end

-- @z [HCL_Loot_MBC] rule:Mouse LMB
-- @z_func: HCL_Loot_MBC.execute_lmb_action [export:rule]
function execute_lmb_action(alt_mod)
    if not loot_state.cursor_idx or not loot_state.cursor_object then
        return
    end
    local npc = hcl_main and hcl_main.get_hovered_corpse() or nil
    if not npc or not is_item_revealed_for_loot(loot_state.cursor_object, npc) then
        return
    end
    if alt_mod then
        local obj = loot_state.cursor_object
        if IsWeapon(obj) and not IsMelee(obj) then
            loot_state.special_func = "field_strip"
            evaluate_special_function()
        elseif is_valid_loaded_magazine(obj) then
            loot_state.special_func = "unload_magazine"
            evaluate_special_function()
        end
        return
    end
    local row = loot_state.grid_rows[loot_state.cursor_idx.y]
    local cell = row and row[loot_state.cursor_idx.x] or nil
    if cell then
        transfer_cell_stack(cell, npc)
        sync_cursor_with_grid()
    end
end

-- @z [HCL_Loot_MBC] rule:Mouse LMB
-- @z_func: HCL_Loot_MBC.execute_vacuum_sweep_step [internal]
local function execute_vacuum_sweep_step(direction, velocity_y)
    if not loot_state.cursor_idx then
        return
    end
    local npc = hcl_main and hcl_main.get_hovered_corpse() or nil
    if not npc then
        return
    end
    local tg = time_global()
    local accel = (hcl_mcm and tonumber(hcl_mcm.get_config("hcl_s_acceleration"))) or 1.0
    mbc_params.s_acceleration = accel
    local brake_window_ms = math.max(140, math.floor(240 * (tonumber(mbc_params.s_brake_factor) or 1.0)))

    -- Absorb scroll-wheel flick momentum across row transitions until the player pauses scrolling
    -- and initiates a distinct new scroll wheel input (or re-presses LMB).
    if mbc_params.row_brake_latched then
        if (tg - (mbc_params.row_brake_tg or 0)) < brake_window_ms then
            mbc_params.row_brake_tg = tg
            return
        end
        mbc_params.row_brake_latched = false
    end

    local raw_vel = math.max(1, tonumber(velocity_y) or 1)
    local step_x = math.max(1, math.floor(raw_vel ^ accel))
    local start_y = loot_state.cursor_idx.y

    for _ = 1, step_x do
        if not loot_state.cursor_idx or loot_state.cursor_idx.y ~= start_y then
            mbc_params.row_brake_latched = true
            mbc_params.row_brake_tg = tg
            break
        end
        local row = loot_state.grid_rows[loot_state.cursor_idx.y]
        local cell = row and row[loot_state.cursor_idx.x] or nil
        if cell and cell.obj and is_item_revealed_for_loot(cell.obj, npc) then
            local cur_x = loot_state.cursor_idx.x
            if transfer_cell_stack(cell, npc) then
                loot_state.lmb_swept_during_hold = true
                table.remove(row, cur_x)
                if #row == 0 then
                    table.remove(loot_state.grid_rows, loot_state.cursor_idx.y)
                    if direction == "UP" and loot_state.cursor_idx.y > 1 then
                        loot_state.cursor_idx.y = loot_state.cursor_idx.y - 1
                        local prev_r = loot_state.grid_rows[loot_state.cursor_idx.y] or {}
                        loot_state.cursor_idx.x = math.max(1, #prev_r)
                    else
                        loot_state.cursor_idx.x = 1
                    end
                    sync_cursor_with_grid()
                    mbc_params.row_brake_latched = true
                    mbc_params.row_brake_tg = tg
                    break
                else
                    if direction == "DOWN" then
                        if cur_x > #row then
                            if loot_state.cursor_idx.y < #loot_state.grid_rows then
                                loot_state.cursor_idx.y = loot_state.cursor_idx.y + 1
                                loot_state.cursor_idx.x = 1
                            else
                                loot_state.cursor_idx.x = #row
                            end
                            sync_cursor_with_grid()
                            mbc_params.row_brake_latched = true
                            mbc_params.row_brake_tg = tg
                            break
                        else
                            loot_state.cursor_idx.x = cur_x
                            sync_cursor_with_grid()
                        end
                    else
                        if cur_x > 1 then
                            loot_state.cursor_idx.x = cur_x - 1
                        else
                            loot_state.cursor_idx.x = 1
                        end
                        sync_cursor_with_grid()
                    end
                end
            else
                break
            end
        else
            step_cursor(direction, false, 1)
            if mbc_params.row_brake_latched or not loot_state.cursor_idx or loot_state.cursor_idx.y ~= start_y then
                mbc_params.row_brake_latched = true
                mbc_params.row_brake_tg = tg
                break
            end
        end
    end
end

-- [SYSTEM] HCL_Loot_KNum

local TAB_DEFAULT_KINDS = {
    [1] = { s_all = true },
    [2] = { w_sniper = true, w_rifle = true, w_smg = true, w_shotgun = true, w_pistol = true, w_melee = true, w_misc = true, w_base = true },
    [3] = { o_heavy = true, o_sci = true, o_medium = true, o_light = true, o_helmet = true, o_backpack = true, i_attach = true },
    [4] = { w_ammo = true, w_explosive = true, mags = true, loadout = true },
    [5] = { i_arty = true, i_arty_junk = true, i_arty_cont = true, i_mutant_belt = true, i_mutant_part = true },
    [6] = { i_device = true, i_kit = true, i_tool = true, i_repair = true, i_upgrade = true, i_part = true },
    [7] = { i_medical = true, i_food = true, i_drink = true, i_mutant_raw = true, i_mutant_cooked = true },
    [8] = { i_letter = true, i_quest = true, i_misc = true, faction_patch = true },
    [9] = { i_part = true, i_upgrade = true, i_repair = true },
    [10] = { i_misc = true, faction_patch = true },
}

-- @z [HCL_Loot_KNum] helper:get_tab_kind_map | bind:hcl_knum_jump_row
-- @z_func: HCL_Loot_KNum.get_tab_kind_map [internal]
local function get_tab_kind_map(tab_num)
    local map = {}
    local fallback = TAB_DEFAULT_KINDS[tab_num]
    if fallback then
        for k, v in pairs(fallback) do
            map[k] = v
        end
    end
    local sec_name = "button_sort_tab_" .. tostring(tab_num)
    if ini_sys and ini_sys:section_exist(sec_name) and type(parse_list) == "function" then
        local kinds = parse_list(ini_sys, sec_name, "kinds")
        if type(kinds) == "table" then
            for i = 1, #kinds do
                local k = kinds[i]
                map[k] = true
                if k == "w_ammo" then
                    map["mags"] = true
                    map["loadout"] = true
                elseif k == "i_misc" then
                    map["faction_patch"] = true
                end
            end
        end
    end
    return map
end

-- @z [HCL_Loot_KNum] rule:Jump Row | bind:hcl_knum_jump_row
-- @z_func: HCL_Loot_KNum.jump_row_by_knum [export:rule]
function jump_row_by_knum(key_num, alt_mod)
    local total_rows = #loot_state.grid_rows
    if total_rows == 0 then
        return
    end
    if not loot_state.cursor_idx then
        loot_state.cursor_idx = { x = 1, y = 1 }
    end
    local target_num = alt_mod and (key_num + 5) or key_num
    local jump_type = (hcl_mcm and hcl_mcm.get_config("hcl_jump_type")) or "Exact Row"

    -- Compat with UIInventory:On_Sort / OnKeyboard and zzz_rax_sortingplus_mcm (set_item_order,
    -- get_sort_kind, actor_on_first_update, loadsettings, on_mcm_load, sort_info, sort_by_size,
    -- sort_by_kind, sort_by_index, sort_by_sizekind, sort_by_props, FindFreeCell).
    if jump_type == "Exact Row" then
        if loot_state.grid_rows[target_num] then
            loot_state.cursor_idx.y = target_num
            loot_state.cursor_idx.x = 1
            sync_cursor_with_grid()
        end
        return
    end

    if target_num == 1 then
        loot_state.cursor_idx.y = 1
        loot_state.cursor_idx.x = 1
        sync_cursor_with_grid()
        return
    end

    local kind_map = get_tab_kind_map(target_num)
    local matching_rows = {}
    for r = 1, total_rows do
        local row = loot_state.grid_rows[r]
        local first_cell = row and row[1] or nil
        local sec = first_cell and (first_cell.sec or (first_cell.obj and first_cell.obj:section())) or nil
        if sec then
            local raw_kind = SYS_GetParam(0, sec, "kind", "") or ""
            local sp_kind = (_G.zzz_rax_sortingplus_mcm and type(_G.zzz_rax_sortingplus_mcm.get_sort_kind) == "function")
                and _G.zzz_rax_sortingplus_mcm.get_sort_kind(sec) or nil
            if kind_map[raw_kind] or (sp_kind and kind_map[sp_kind]) then
                matching_rows[#matching_rows + 1] = r
            end
        end
    end

    if #matching_rows > 0 then
        local cur_y = loot_state.cursor_idx.y
        local next_row = matching_rows[1]
        for i = 1, #matching_rows do
            if matching_rows[i] == cur_y then
                next_row = matching_rows[(i % #matching_rows) + 1]
                break
            end
        end
        loot_state.cursor_idx.y = next_row
        loot_state.cursor_idx.x = 1
        sync_cursor_with_grid()
    end
end

-- @z [HCL_Loot] helper:is_univ_modifier_held
-- @z_func: HCL_Loot.is_univ_modifier_held [internal]
local function is_univ_modifier_held()
    local mod_dik = (hcl_mcm and tonumber(hcl_mcm.get_config("hcl_univ_modifier"))) or (DIK_keys and DIK_keys.DIK_LMENU) or 56
    if type(key_state) == "function" then
        if key_state(mod_dik) ~= 0 then
            return true
        end
    end
    return loot_state.alt_modifier == true
end

local DIK_TO_NUM = {
    [2] = 1, [3] = 2, [4] = 3, [5] = 4, [6] = 5,
    [79] = 1, [80] = 2, [81] = 3, [75] = 4, [76] = 5,
}

-- @z [HCL_Loot] state:LOOT | bind:hcl_knum_jump_row | states:IDLE,LOOT
-- @z_func: HCL_Loot.on_before_key_press [export:callback]
function on_before_key_press(key, bind, dis, flags)
    local mod_dik = (hcl_mcm and tonumber(hcl_mcm.get_config("hcl_univ_modifier"))) or (DIK_keys and DIK_keys.DIK_LMENU) or 56
    if key == mod_dik then
        loot_state.alt_modifier = true
    end
    local cb_status = hcl_main and hcl_main.get_callback_status() or "IDLE"
    if cb_status ~= "LOOT" then
        return
    end

    local mouse_1 = DIK_keys and DIK_keys.MOUSE_1 or 337
    local mouse_2 = DIK_keys and DIK_keys.MOUSE_2 or 338
    local wpn_fire = key_bindings and key_bindings.kWPN_FIRE or nil
    local wpn_zoom = key_bindings and key_bindings.kWPN_ZOOM or nil
    local wpn_next = key_bindings and key_bindings.kWPN_NEXT or nil

    if key == mouse_1 or (wpn_fire and bind == wpn_fire) then
        if flags then
            flags.ret_value = false
        end
        if not loot_state.lmb_held then
            loot_state.lmb_held = true
            loot_state.lmb_press_tg = time_global()
            loot_state.lmb_swept_during_hold = false
            mbc_params.row_brake_latched = false
        end
        return
    end

    if key == mouse_2 or (wpn_zoom and bind == wpn_zoom) then
        if flags then
            flags.ret_value = false
        end
        if not loot_state.rmb_held then
            loot_state.rmb_held = true
            loot_state.rmb_press_tg = time_global()
            loot_state.rmb_disassembly_consumed = false
        end
        return
    end

    local knum = DIK_TO_NUM[key]
    if knum then
        if flags then
            flags.ret_value = false
        end
        jump_row_by_knum(knum, is_univ_modifier_held())
        return
    end

    if key_bindings then
        if (wpn_next and bind == wpn_next)
            or bind == key_bindings.kWPN_1
            or bind == key_bindings.kWPN_2
            or bind == key_bindings.kWPN_3
            or bind == key_bindings.kWPN_4
            or bind == key_bindings.kWPN_5
            or bind == key_bindings.kWPN_6
        then
            if flags then
                flags.ret_value = false
            end
        end
    end
end

-- @z [HCL_Loot] state:LOOT | bind:hcl_autolooter_rmb | states:IDLE,LOOT
-- @z_func: HCL_Loot.process_mouse_release_edges [internal]
local function process_mouse_release_edges(force_lmb, force_rmb)
    local tg = time_global()
    local alt_held = is_univ_modifier_held()

    if loot_state.lmb_held and (force_lmb or (tg - loot_state.lmb_press_tg > 350 and (type(key_state) ~= "function" or key_state(DIK_keys and DIK_keys.MOUSE_1 or 337) == 0))) then
        loot_state.lmb_held = false
        if not loot_state.lmb_swept_during_hold then
            execute_lmb_action(alt_held)
        end
        loot_state.lmb_swept_during_hold = false
        mbc_params.row_brake_latched = false
    end

    if loot_state.rmb_held and (force_rmb or (tg - loot_state.rmb_press_tg > 350 and (type(key_state) ~= "function" or key_state(DIK_keys and DIK_keys.MOUSE_2 or 338) == 0))) then
        loot_state.rmb_held = false
        execute_rmb_loot_or_autoloot(alt_held)
    end
end

-- @z [HCL_Loot] state:LOOT | states:IDLE,LOOT
-- @z_func: HCL_Loot.on_key_release [export:callback]
function on_key_release(key, bind)
    local mod_dik = (hcl_mcm and tonumber(hcl_mcm.get_config("hcl_univ_modifier"))) or (DIK_keys and DIK_keys.DIK_LMENU) or 56
    if key == mod_dik then
        loot_state.alt_modifier = false
    end
    local cb_status = hcl_main and hcl_main.get_callback_status() or "IDLE"
    if cb_status ~= "LOOT" then
        loot_state.lmb_held = false
        loot_state.rmb_held = false
        return
    end
    local mouse_1 = DIK_keys and DIK_keys.MOUSE_1 or 337
    local mouse_2 = DIK_keys and DIK_keys.MOUSE_2 or 338
    if key == mouse_1 then
        process_mouse_release_edges(true, false)
    elseif key == mouse_2 then
        process_mouse_release_edges(false, true)
    end
end

-- @z [HCL_Loot] state:LOOT | states:LOOT
-- @z_func: HCL_Loot.on_mouse_wheel [export:callback]
function on_mouse_wheel(vol)
    local cb_status = hcl_main and hcl_main.get_callback_status() or "IDLE"
    if cb_status ~= "LOOT" then
        return
    end
    local direction = (tonumber(vol) and tonumber(vol) > 0) and "UP" or "DOWN"
    local tg = time_global()
    local dt = tg - scroll_params.last_scroll_tg
    scroll_params.last_scroll_tg = tg
    if dt < 65 then
        scroll_params.velocity_steps = math.min(4, scroll_params.velocity_steps + 1)
    else
        scroll_params.velocity_steps = 1
    end

    if loot_state.lmb_held then
        execute_vacuum_sweep_step(direction, scroll_params.velocity_steps)
    else
        step_cursor(direction, is_univ_modifier_held(), 1)
    end
end

-- @z [HCL_Loot] state:IDLE | bind:hcl_mag_redux_unload | states:IDLE,LOOT
-- @z_func: HCL_Loot.evaluate_loot_state [export:state]
function evaluate_loot_state()
    local cb_status = hcl_main and hcl_main.get_callback_status() or "IDLE"
    if cb_status ~= "LOOT" then
        if loot_state.was_in_loot then
            loot_state.was_in_loot = false
            if _G.magazines and type(_G.magazines.do_interrupt_magload) == "function" then
                pcall(_G.magazines.do_interrupt_magload)
            end
        end
        loot_state.cursor_idx = nil
        loot_state.cursor_object = nil
        loot_state.lmb_held = false
        loot_state.rmb_held = false
        loot_state.special_func = nil
        return "IDLE"
    end
    if not loot_state.was_in_loot then
        loot_state.was_in_loot = true
        loot_state.cursor_idx = { x = 1, y = 1 }
        sync_cursor_with_grid()
        z_probe("evaluate_loot_state", "Entered LOOT state cursor=(1,1)")
    end
    process_mouse_release_edges(false, false)
    return "LOOT"
end

-- @z [HCL_Loot] dispatcher:actor_on_update
-- @z_func: HCL_Loot.actor_on_update [export:callback]
function actor_on_update()
    evaluate_loot_state()
end

-- @z [HCL_Loot] helper:install_mag_redux_hook | bind:hcl_mag_redux_unload
-- @z_func: HCL_Loot.install_mag_redux_hook [internal]
local function install_mag_redux_hook()
    if _G.magazine_binder and type(_G.magazine_binder.set_data) == "function" and not _G.magazine_binder._hcl_set_data_wrapped then
        local orig_set_data = _G.magazine_binder.set_data
        _G.magazine_binder._hcl_set_data_wrapped = true
        _G.magazine_binder.set_data = function(id, data, ...)
            local res = orig_set_data(id, data, ...)
            if loot_state.was_in_loot and hcl_ui and type(hcl_ui.request_grid_refresh) == "function" then
                hcl_ui.request_grid_refresh()
            end
            return res
        end
    end
end

-- @z [HCL_Loot] rule:Cursor Parameters
-- @z_func: HCL_Loot.get_cursor_params [export:output]
function get_cursor_params()
    return loot_state.cursor_idx, loot_state.cursor_object
end

-- @z [HCL_Loot] rule:get_cursor_idx
-- @z_func: HCL_Loot.get_cursor_idx [export:output]
function get_cursor_idx()
    return loot_state.cursor_idx
end

-- @z [HCL_Loot] rule:get_cursor_object
-- @z_func: HCL_Loot.get_cursor_object [export:output]
function get_cursor_object()
    return loot_state.cursor_object
end

-- @z [HCL_Loot] dispatcher:on_game_start
-- @z_func: HCL_Loot.on_game_start [export:callback]
function on_game_start()
    install_mag_redux_hook()
    RegisterScriptCallback("on_before_key_press", on_before_key_press)
    RegisterScriptCallback("on_key_release", on_key_release)
    RegisterScriptCallback("on_mouse_wheel", on_mouse_wheel)
    RegisterScriptCallback("actor_on_update", actor_on_update)
end
